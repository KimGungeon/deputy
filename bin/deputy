#!/usr/bin/env python3
"""
deputy - 여러 Claude Code 세션이 사람 없이 토론하고 합의하며 일하게 만든다.

상태는 전부 GitHub 이슈에 있다. 로컬에 숨은 저장소가 없다.
  · 작업 단위      = 이슈
  · 토론           = 이슈 코멘트
  · 합의 상태      = 라벨 (deputy:next / deputy:agreed / deputy:revise / deputy:wip / deputy:blocked)
  · 착수자         = assignee
  · 완료           = 이슈 close
그래서 출근한 자리에서 폰으로 GitHub 앱만 열면 진행 상황이 그대로 보이고,
코멘트 한 줄로 개입할 수 있다.

로컬 파일은 .deputy/deputy.json 하나뿐이고 이건 상태가 아니라 설정이다
(누가 어느 디렉터리를 담당하는지). 저장소에 커밋해서 팀과 공유한다.

모든 세션이 같은 GitHub 계정으로 움직이므로 코멘트 작성자로는 서로를 구분할 수 없다.
그래서 각 코멘트 첫 줄에 기계가 읽는 마커를 넣어 누가 썼는지 표시한다.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

HOME = os.path.expanduser("~")
# 심볼릭 링크로 설치돼도 자기 패키지(skills/, settings/)를 찾을 수 있어야 한다
PKG_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

WORKFLOW = """
작업 흐름
─────────────────────────────────────────────────────────────────────────
  세션은 매 턴 `deputy next` 를 실행하고, 나온 지시를 그대로 따른다.
  무엇을 할지 스스로 정하지 않는다.

  이슈 하나를 지목해 처리하려면 번호만 주면 된다.

    deputy 7        #7 에 대해 지금 할 일을 판단한다.
                    착수·분해안 적용처럼 인자가 필요 없는 행동은 바로 실행하고,
                    제안·리뷰·완료처럼 판단이 필요한 것은 명령을 출력한다.
    deputy 7 --dry  실행하지 않고 무엇을 할지만 본다.

    deputy next
      │
      ├─ 리뷰 요청이 와 있다 ──→ deputy review <n> --verdict AGREE|OBJECT|AMEND
      │                                            --reason "확인한 것과 우려"
      │
      ├─ 진행 중인 작업이 있다 ─→ 계속 구현
      │                          문제 발견 시 deputy derive <부모> ...
      │                          끝나면    deputy done <n> --close --result "..."
      │
      ├─ 내 제안 판정이 났다 ──→ CLAIM    : deputy claim <n>
      │                          REVISE   : deputy propose <n> (수정본)
      │                          ESCALATE : 범위를 좁혀 진행
      │                          WAIT     : 멈추지 말고 사전 조사
      │
      └─ 할 게 없다 ──────────→ deputy propose <n> --why ... --done-when ...

  판정은 결정론적이고 교착하지 않는다.
  리뷰가 45분간 없으면 기권 처리되어 자동으로 진행된다.

우선순위 (deputy next 가 이 순서로 정렬해서 준다)
─────────────────────────────────────────────────────────────────────────
  0. 사람이 남긴 이슈 코멘트      유일한 외부 신호다
  1. 내가 해야 할 리뷰            내가 안 하면 남이 막힌다
  2. 내가 진행 중인 작업          파생 이슈를 부모보다 먼저
  3. 내 제안의 판정
  4. 새 작업 제안                 위가 전부 비었을 때만

처음이라면
─────────────────────────────────────────────────────────────────────────
  deputy init --member "api:src/api:백엔드"  저장소 준비 (라벨·설정·스킬)
  deputy doctor                              무인 운영 전 점검
  deputy-up.sh                               출근 전 기동
"""

MARK = re.compile(
    r"<!--\s*deputy\s+v1\s+kind=(?P<kind>\w+)\s+by=(?P<by>[\w.-]+)"
    r"(?:\s+rev=(?P<rev>\d+))?(?:\s+verdict=(?P<verdict>\w+))?\s*-->"
)
VERDICTS = ("AGREE", "OBJECT", "AMEND")
DERIVE_MARK = re.compile(r"<!--\s*deputy\s+v1\s+kind=derive\s+by=[\w.-]+\s+parent=(?P<parent>\d+)\s*-->")
PLAN_MARK = re.compile(r"<!--\s*deputy\s+v1\s+kind=plan\s+by=(?P<by>[\w.-]+)\s+rev=(?P<rev>\d+)\s*-->")
PLANNED_MARK = re.compile(
    r"<!--\s*deputy\s+v1\s+kind=planned\s+by=[\w.-]+\s+parent=(?P<parent>\d+)"
    r"\s+owner=(?P<owner>[\w.-]+)(?:\s+after=(?P<after>[\d,]*))?\s*-->")
PLAN_JSON = re.compile(r"```deputy-plan\s*\n(?P<body>.*?)\n```", re.S)
MAX_PLAN_CHILDREN = 12
TASKLINE = re.compile(r"^- \[(?P<done>[ xX])\] #(?P<num>\d+)", re.M)
COORDINATOR = "coordinator"   # 담당 디렉터리 없이 전체를 조율하는 역할
BUILDER = "builder"           # 담당 디렉터리를 가지고 실제로 구현하는 역할
MAX_CHILDREN = 3          # 부모당 파생 이슈 상한. 넘으면 범위 설정이 틀린 것이다
ISSUE_CACHE = {}          # deputy next 한 번에 같은 이슈를 여러 번 받아오지 않기 위한 캐시
LABELS = {
    "deputy:next":    ("0E8A16", "deputy: 다음 작업으로 제안됨, 검토 대기"),
    "deputy:agreed":  ("1D76DB", "deputy: 합의 완료, 착수 가능"),
    "deputy:revise":  ("FBCA04", "deputy: 이견 있음, 제안 수정 필요"),
    "deputy:wip":     ("5319E7", "deputy: 진행 중"),
    "deputy:blocked": ("B60205", "deputy: 합의 실패, 사람의 판단 필요"),
    "deputy:epic":    ("6F42C1", "deputy: 자식 이슈로 쪼개진 큰 작업"),
}


# ---------------------------------------------------------------- 공통

def die(msg, code=1):
    print(f"deputy: {msg}", file=sys.stderr)
    sys.exit(code)


def stamp(ts=None):
    return datetime.fromtimestamp(ts or time.time()).strftime("%m-%d %H:%M")


def parse_iso(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def gh(args, check=True, parse=False):
    """gh CLI 호출. 네트워크가 끊겨도 세션이 죽지 않게 실패를 값으로 돌려준다."""
    try:
        r = subprocess.run(["gh"] + args, capture_output=True, text=True, timeout=45)
    except FileNotFoundError:
        die("gh CLI 가 없습니다. `brew install gh` 후 `gh auth login`.")
    except subprocess.TimeoutExpired:
        if check:
            die("gh 호출이 45초 안에 끝나지 않았습니다. 네트워크를 확인하세요.")
        return None
    if r.returncode != 0:
        if check:
            die(f"gh {' '.join(args[:3])} 실패\n{r.stderr.strip()}")
        return None
    return json.loads(r.stdout) if parse else r.stdout


def repo_root():
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die("git 저장소 안에서 실행하세요.")
    return r.stdout.strip()


def _strip_comments(obj):
    """설정 스니펫의 _주석 키를 제거한다."""
    if isinstance(obj, dict):
        return {k: _strip_comments(v) for k, v in obj.items() if not k.startswith("_")}
    if isinstance(obj, list):
        return [_strip_comments(v) for v in obj]
    return obj


def merge_settings(target_path, snippet, label):
    """
    기존 설정을 절대 덮어쓰지 않는 병합.
      - 리스트는 합집합 (permissions.allow/deny)
      - 딕셔너리는 재귀 병합
      - 이미 값이 있는 스칼라 키는 그대로 둔다 (사용자 선택이 이긴다)
    바꾸기 전에 .bak 을 남긴다.
    """
    snippet = _strip_comments(snippet)
    existing = {}
    if os.path.exists(target_path):
        try:
            existing = json.load(open(target_path))
        except Exception as e:
            print(f"  [건너뜀] {label}: 기존 파일을 읽을 수 없습니다 ({e})")
            return False
        shutil.copy2(target_path, target_path + ".bak")

    kept = []

    def merge(dst, src, path=""):
        for k, v in src.items():
            here = f"{path}.{k}" if path else k
            if k not in dst:
                dst[k] = v
            elif isinstance(dst[k], dict) and isinstance(v, dict):
                merge(dst[k], v, here)
            elif isinstance(dst[k], list) and isinstance(v, list):
                for item in v:
                    if item not in dst[k]:
                        dst[k].append(item)
            elif dst[k] != v:
                kept.append((here, dst[k], v))
        return dst

    merged = merge(existing, snippet)
    os.makedirs(os.path.dirname(target_path), exist_ok=True)
    with open(target_path, "w") as f:
        json.dump(merged, f, indent=2, ensure_ascii=False)

    print(f"  {label}: 병합 완료" + (f" (백업 {os.path.basename(target_path)}.bak)"
                                    if os.path.exists(target_path + ".bak") else ""))
    for key, mine, theirs in kept:
        print(f"    · {key} 는 기존값 {mine!r} 유지 (권장값 {theirs!r})")
    return True


def install_skills(dest_dir):
    """플러그인으로 설치하지 않은 경우를 위해 스킬을 프로젝트에 복사한다."""
    src = os.path.join(PKG_DIR, "skills")
    if not os.path.isdir(src):
        print(f"  [건너뜀] 스킬: {src} 를 찾을 수 없습니다")
        return
    os.makedirs(dest_dir, exist_ok=True)
    for name in sorted(os.listdir(src)):
        s_dir, d_dir = os.path.join(src, name), os.path.join(dest_dir, name)
        if not os.path.isdir(s_dir):
            continue
        if os.path.exists(d_dir):
            shutil.rmtree(d_dir)
        shutil.copytree(s_dir, d_dir)
        print(f"  스킬 설치: .claude/skills/{name}/")


def cmd_self_install(cfg_unused, args):
    """deputy 를 PATH 에 올린다. 플러그인으로 설치했다면 필요 없다."""
    target_dir = os.path.expanduser(args.prefix)
    os.makedirs(target_dir, exist_ok=True)
    link = os.path.join(target_dir, "deputy")
    src = os.path.realpath(__file__)
    if os.path.islink(link) or os.path.exists(link):
        if not args.force:
            die(f"{link} 이 이미 있습니다. 덮어쓰려면 --force.")
        os.remove(link)
    os.symlink(src, link)
    print(f"설치 완료: {link} → {src}")
    if target_dir not in os.environ.get("PATH", "").split(":"):
        print(f"\n[주의] {target_dir} 이 PATH 에 없습니다. 셸 설정에 추가하세요:")
        print(f'  export PATH="{target_dir}:$PATH"')
    print("\n이제 어느 저장소에서나 `deputy init` 으로 시작할 수 있습니다.")


def load_config():
    path = os.path.join(repo_root(), ".deputy", "deputy.json")
    if not os.path.isfile(path):
        die("`.deputy/deputy.json` 이 없습니다. 먼저 `deputy init` 을 실행하세요.")
    cfg = json.load(open(path))
    cfg["_path"] = path
    cfg["_root"] = repo_root()
    cfg.setdefault("review_timeout_minutes", 45)
    cfg.setdefault("max_revisions", 2)
    return cfg


def members(cfg):
    return [m["name"] for m in cfg["members"]]


def whoami(cfg, explicit=None):
    name = explicit or os.environ.get("DEPUTY_MEMBER")
    if not name:
        die("나를 식별할 수 없습니다. DEPUTY_MEMBER 환경변수를 설정하거나 --as <이름>.")
    if name not in members(cfg):
        die(f"'{name}' 은 등록된 멤버가 아닙니다: {', '.join(members(cfg))}")
    return name


def role_of(cfg, name):
    return member_cfg(cfg, name).get("role", BUILDER)


def coordinators(cfg):
    return [m["name"] for m in cfg["members"] if m.get("role") == COORDINATOR]


def member_cfg(cfg, name):
    return next((m for m in cfg["members"] if m["name"] == name), {})


# ---------------------------------------------------------------- 이슈 읽기

def list_issues(state="open", labels=None, limit=200):
    """
    열린 이슈 목록. labels 를 여러 개 주면 gh 는 AND 로 해석한다(OR 이 아니다).
    지금은 한 번에 하나만 넘기지만, 나중에 OR 이 필요하면 라벨별로 따로 부르고 합쳐야 한다.
    """
    args = ["issue", "list", "--state", state, "--limit", str(limit),
            "--json", "number,title,labels,assignees,body,updatedAt,url"]
    for l in (labels or []):
        args += ["--label", l]
    return gh(args, parse=True) or []


def active_issues():
    """
    목록 + 진행 중인 것들. 목록 상한에서 밀려나 진행 중이던 작업이 사라지면
    세션이 '할 일 없음'으로 오판하고 새 일을 벌인다. 그래서 wip 은 따로 합친다.
    """
    seen = {}
    for i in list_issues():
        seen[i["number"]] = i
    for lb in ("deputy:wip", "deputy:agreed", "deputy:next"):
        for i in list_issues(labels=[lb], limit=100):
            seen.setdefault(i["number"], i)
    return list(seen.values())


def issue(num, cached=False, check=True):
    """
    이슈 하나를 받아온다.
    cached=True 면 이번 프로세스 안에서 한 번만 네트워크를 탄다.
    check=False 면 실패해도 죽지 않고 None 을 돌려준다. 무인 운영에서 gh 호출 한 번이
    실패했다고 그 턴 전체를 날리면 안 되기 때문이다.
    """
    if cached and num in ISSUE_CACHE:
        return ISSUE_CACHE[num]
    d = gh(["issue", "view", str(num), "--json",
            "number,title,body,labels,assignees,comments,state,url"],
           parse=True, check=check)
    if cached and d:
        ISSUE_CACHE[num] = d
    return d


def label_names(iss):
    return {l["name"] for l in iss.get("labels", [])}


def deputy_comments(iss):
    """마커가 붙은 코멘트만 뽑아 구조화한다. 사람이 쓴 일반 코멘트는 건드리지 않는다."""
    out = []
    for c in iss.get("comments", []):
        m = MARK.search(c.get("body", "") or "")
        if not m:
            continue
        out.append({
            "kind": m.group("kind"),
            "by": m.group("by"),
            "rev": int(m.group("rev") or 1),
            "verdict": m.group("verdict"),
            "at": parse_iso(c["createdAt"]),
            "body": c["body"],
        })
    return sorted(out, key=lambda x: x["at"])


def human_comments_since(iss, ts):
    """사람이 개입한 코멘트. 세션은 이걸 최우선으로 읽어야 한다."""
    out = []
    for c in iss.get("comments", []):
        if MARK.search(c.get("body", "") or ""):
            continue
        if parse_iso(c["createdAt"]) > ts:
            out.append(c)
    return out


# ---------------------------------------------------------------- 합의 판정

def consensus(cfg, iss):
    """
    결정론적 판정. 어느 세션에서 돌려도 같은 결과가 나온다.
    절대 교착하지 않는다 - 리뷰가 안 들어와도 제한 시간이 지나면 기권으로 처리한다.
    사람이 없는 8시간 동안 '합의를 기다리며 정지'가 가장 나쁜 결과이기 때문이다.
    """
    cs = deputy_comments(iss)
    # 분해안(plan)도 제안과 똑같이 합의를 거친다. 둘 다 rev 를 달고 있어 리뷰가 붙는다.
    props = [c for c in cs if c["kind"] in ("propose", "plan")]
    if not props:
        return {"decision": "NONE", "reason": "아직 제안되지 않은 이슈입니다.", "detail": {}}

    p = props[-1]
    rev, proposer = p["rev"], p["by"]
    others = [m for m in members(cfg) if m != proposer]
    timeout_s = cfg["review_timeout_minutes"] * 60
    age = time.time() - p["at"]

    revs = {c["by"]: c for c in cs
            if c["kind"] == "review" and c["rev"] == rev and c["by"] != proposer}

    agree, obj, amend, pending, abstain = [], [], [], [], []
    for m in others:
        r = revs.get(m)
        if not r:
            (abstain if age >= timeout_s else pending).append(m)
        elif r["verdict"] == "AGREE":
            agree.append(m)
        elif r["verdict"] == "OBJECT":
            obj.append(m)
        else:
            amend.append(m)

    detail = {"revision": rev, "proposer": proposer, "age_min": round(age / 60, 1),
              "agree": agree, "object": obj, "amend": amend,
              "pending": pending, "abstained": abstain}

    if obj or amend:
        if rev > cfg["max_revisions"]:
            return {"decision": "ESCALATE", "detail": detail,
                    "reason": f"수정 {rev-1}회 후에도 이견이 남았습니다. "
                              f"이견이 가장 적은 범위로 좁혀 진행하고, 왜 그렇게 정했는지 "
                              f"이슈에 남기세요. 범위를 못 좁히겠으면 deputy:blocked 를 달고 "
                              f"다음 작업으로 넘어가세요."}
        return {"decision": "REVISE", "detail": detail,
                "reason": f"{', '.join(obj + amend)} 의 이견이 있습니다. "
                          f"리뷰를 읽고 제안을 고치세요."}

    if pending:
        return {"decision": "WAIT", "detail": detail,
                "reason": f"{', '.join(pending)} 의 리뷰 대기 중. "
                          f"{round((timeout_s-age)/60,1)}분 뒤 기권 처리되어 자동 진행됩니다. "
                          f"기다리는 동안 멈추지 말고 사전 조사를 하세요."}

    if agree:
        return {"decision": "CLAIM", "detail": detail,
                "reason": f"{', '.join(agree)} 동의. 착수하세요."}

    return {"decision": "CLAIM", "detail": detail,
            "reason": f"제한 시간 내 리뷰가 없어 기권 처리했습니다 "
                      f"({', '.join(abstain)}). 검토 없이 진행하므로 "
                      f"되돌리기 쉬운 작은 단위로 나눠 하세요."}


def set_labels(num, add=(), remove=(), verify=True):
    """
    라벨은 이 도구의 상태 그 자체다. 쓰기가 조용히 실패하면 상태 기계가 어긋난 채
    8시간을 돈다. 그래서 한 번 재시도하고, 그래도 안 되면 크게 경고한다.
    """
    args = ["issue", "edit", str(num)]
    for a in add:
        args += ["--add-label", a]
    for r in remove:
        args += ["--remove-label", r]
    if len(args) <= 3:
        return True

    for attempt in (1, 2):
        if gh(args, check=False) is not None:
            break
        time.sleep(2)
    else:
        print(f"  [경고] #{num} 라벨 쓰기 실패. 상태가 어긋날 수 있습니다.", file=sys.stderr)
        return False

    if not verify:
        return True
    cur = issue(num, check=False)
    if cur is None:
        return True                       # 확인만 실패한 것이므로 성공으로 본다
    have = label_names(cur)
    missing = set(add) - have
    left = set(remove) & have
    if missing or left:
        print(f"  [경고] #{num} 라벨이 의도와 다릅니다. "
              f"누락={sorted(missing)} 잔존={sorted(left)}", file=sys.stderr)
        return False
    return True


def sync_label(cfg, num, decision):
    m = {"CLAIM": "deputy:agreed", "REVISE": "deputy:revise",
         "ESCALATE": "deputy:blocked", "WAIT": "deputy:next"}
    want = m.get(decision)
    if want:
        set_labels(num, add=[want], remove=[l for l in m.values() if l != want])


# ---------------------------------------------------------------- 명령

# ---------------------------------------------------------------- 구조 감지

SKIP_DIRS = {
    "node_modules", "vendor", "dist", "build", "out", "target", "coverage",
    ".git", ".venv", "venv", "__pycache__", ".next", ".nuxt", ".svelte-kit",
    "migrations", "fixtures", "snapshots", ".claude", ".deputy", ".github",
}
# 이 이름들은 그 자체가 담당 단위라기보다 하위를 봐야 하는 껍데기다
CONTAINER_DIRS = {"src", "lib", "packages", "apps", "services", "crates", "cmd",
                  "modules", "components", "internal", "pkg"}
TEST_DIRS = {"test", "tests", "spec", "specs", "__tests__", "e2e", "cypress"}

LANG_BY_EXT = {
    ".py": "Python", ".ts": "TypeScript", ".tsx": "TypeScript React",
    ".js": "JavaScript", ".jsx": "JavaScript React", ".go": "Go",
    ".rs": "Rust", ".java": "Java", ".kt": "Kotlin", ".rb": "Ruby",
    ".php": "PHP", ".cs": "C#", ".swift": "Swift", ".c": "C", ".cpp": "C++",
    ".h": "C/C++ 헤더", ".sql": "SQL", ".css": "CSS", ".scss": "SCSS",
    ".html": "HTML", ".vue": "Vue", ".svelte": "Svelte", ".sh": "셸",
    ".md": "문서", ".json": "설정", ".yml": "설정", ".yaml": "설정",
}
CODE_EXTS = {e for e in LANG_BY_EXT if e not in (".md", ".json", ".yml", ".yaml")}


def shebang_ext(path):
    """확장자가 없는 파일은 첫 줄의 shebang 으로 언어를 추정한다."""
    try:
        with open(path, "rb") as f:
            first = f.readline(120).decode("utf-8", "replace")
    except Exception:
        return ""
    if not first.startswith("#!"):
        return ""
    for key, ext in (("python", ".py"), ("node", ".js"), ("ruby", ".rb"),
                     ("bash", ".sh"), ("sh", ".sh"), ("zsh", ".sh"), ("perl", ".pl")):
        if key in first:
            return ext
    return ".sh"


def tracked_files(root):
    """git 이 아는 파일만 본다. .gitignore 가 이미 쓰레기를 걸러준다."""
    r = subprocess.run(["git", "-C", root, "ls-files"], capture_output=True, text=True)
    if r.returncode != 0:
        return []
    return [f for f in r.stdout.splitlines() if f]


def scan_repo(root):
    """
    저장소를 훑어 '담당 단위가 될 만한 디렉터리' 후보를 만든다.
    규칙은 두 가지뿐이다.
      · src/ packages/ 처럼 껍데기 디렉터리는 한 단계 더 들어간다
      · tests/api 같은 테스트 디렉터리는 대응하는 코드 디렉터리에 붙인다
    """
    files = tracked_files(root)
    buckets = {}          # 경로 -> {"files": n, "exts": {ext: n}}

    for f in files:
        parts = f.split("/")
        if any(p in SKIP_DIRS for p in parts[:-1]):
            continue
        if len(parts) == 1:
            key = "(루트 파일)"
        else:
            top = parts[0]
            if top in CONTAINER_DIRS and len(parts) > 2:
                key = f"{top}/{parts[1]}"
            elif top in TEST_DIRS and len(parts) > 2:
                key = f"{top}/{parts[1]}"
            else:
                key = top
        b = buckets.setdefault(key, {"files": 0, "exts": {}})
        b["files"] += 1
        ext = os.path.splitext(f)[1].lower()
        if not ext:
            ext = shebang_ext(os.path.join(root, f))
        b["exts"][ext] = b["exts"].get(ext, 0) + 1

    cands = []
    for path, b in buckets.items():
        code = sum(n for e, n in b["exts"].items() if e in CODE_EXTS)
        cands.append({"path": path, "files": b["files"], "code": code, "exts": b["exts"]})

    # 테스트 디렉터리를 대응하는 코드 디렉터리에 흡수시킨다
    by_leaf = {}
    for c in cands:
        leaf = c["path"].split("/")[-1]
        if c["path"].split("/")[0] not in TEST_DIRS:
            by_leaf.setdefault(leaf, c)
    merged, absorbed = [], set()
    for c in cands:
        head = c["path"].split("/")[0]
        leaf = c["path"].split("/")[-1]
        if head in TEST_DIRS and leaf in by_leaf and by_leaf[leaf]["path"] != c["path"]:
            tgt = by_leaf[leaf]
            tgt.setdefault("extra", []).append(c["path"])
            tgt["files"] += c["files"]; tgt["code"] += c["code"]
            absorbed.add(c["path"])
    for c in cands:
        if c["path"] not in absorbed:
            merged.append(c)

    merged.sort(key=lambda c: (-c["code"], -c["files"], c["path"]))
    return merged


def describe(c):
    """이 디렉터리가 무엇인지 한 줄로. 지배적인 언어와 파일 수로 만든다."""
    langs = {}
    for e, n in c["exts"].items():
        if e in LANG_BY_EXT:
            langs[LANG_BY_EXT[e]] = langs.get(LANG_BY_EXT[e], 0) + n
    top = sorted(langs.items(), key=lambda x: -x[1])[:2]
    lang = " · ".join(k for k, _ in top) or "기타"
    return f"{lang}, 파일 {c['files']}개"


def member_name(path, used):
    """디렉터리 이름에서 멤버 이름을 만든다. 중복이면 상위 경로를 붙인다."""
    leaf = path.split("/")[-1]
    name = re.sub(r"[^a-z0-9-]", "-", leaf.lower()).strip("-") or "core"
    if name in used:
        prefix = re.sub(r"[^a-z0-9-]", "-", path.split("/")[0].lower())
        name = f"{prefix}-{name}"
    i = 2
    base = name
    while name in used:
        name = f"{base}{i}"; i += 1
    used.add(name)
    return name


def propose_members(cands, n, with_coordinator=True):
    """
    담당은 '지배적인 디렉터리'만 준다. 남는 것을 억지로 배분하지 않는다.

    남은 디렉터리를 전부 나눠 가지면 담당 경계가 의미를 잃는다. 그보다 무주지로
    두는 편이 낫다. 무주지를 건드려야 하는 작업은 제안 단계에서 그 사실을 밝히게 되고,
    그러면 다른 세션이 리뷰에서 걸러낼 기회가 생긴다.
    """
    ownable = [c for c in cands
               if c["path"] != "(루트 파일)" and not c["path"].startswith(".")]
    seeds = [c for c in ownable if c["code"] > 0][:n]
    if len(seeds) < n:
        # 코드 디렉터리가 요청한 멤버 수보다 적으면 문서·설정 디렉터리로 채운다.
        # 담당이 갈리기만 하면 합의는 성립하고, 1인 운영보다는 낫다.
        rest = [c for c in ownable if c["code"] == 0]
        seeds = seeds + rest[: n - len(seeds)]
    if not seeds:
        seeds = ownable[:n]

    used, members = set(), []
    for c in seeds:
        owns = [c["path"]] + c.get("extra", [])
        # 이 씨앗의 하위 경로는 함께 가져간다 (services/x 를 services 가 먹지 않도록
        # 정확히 prefix 인 것만)
        for other in ownable:
            if other is c:
                continue
            if other["path"].startswith(c["path"] + "/"):
                owns.append(other["path"])
                owns.extend(other.get("extra", []))
        members.append({
            "name": member_name(c["path"], used),
            "owns": sorted(set(owns)),
            "brief": describe(c),
        })

    for m in members:
        m["role"] = BUILDER

    claimed = {o for m in members for o in m["owns"]}
    unowned = [c["path"] for c in cands if c["path"] not in claimed]

    if with_coordinator:
        # 담당이 없으므로 파일 충돌을 일으킬 수 없고, 전체를 보는 눈이 하나 생긴다.
        # 멤버가 둘뿐일 때는 이 한 명이 정족수를 실질적으로 만들어 준다.
        members.insert(0, {
            "name": "lead",
            "role": COORDINATOR,
            "owns": [],
            "brief": "담당 디렉터리 없음. 전체 우선순위 조율, 제안 교차 검증, "
                     "충돌·정체 중재, 무주지 판단",
        })
    return members, unowned


def print_scan(root, cands, members, unowned):
    print(f"=== 구조 감지 :: {os.path.basename(root)} ===\n")
    if not cands:
        print("  추적 중인 파일이 없습니다. git add 를 먼저 하세요.")
        return
    print("후보 디렉터리 (코드 파일 수 순)")
    for c in cands[:12]:
        extra = f"  +{', '.join(c['extra'])}" if c.get("extra") else ""
        print(f"  {c['path']:<34} 코드 {c['code']:>4}  전체 {c['files']:>4}  {describe(c)}{extra}")
    if len(cands) > 12:
        print(f"  … 외 {len(cands)-12}개")

    print(f"\n제안 멤버 {len(members)}명")
    for m in members:
        tag = "[조율]" if m.get("role") == COORDINATOR else "[담당]"
        print(f"  {tag} {m['name']:<12} {', '.join(m['owns']) or '(디렉터리 없음)'}")
        print(f"  {'':<7}{'':<12} {m['brief']}")

    if unowned:
        print(f"\n무주지 {len(unowned)}곳 — 아무도 담당하지 않습니다")
        head = ", ".join(unowned[:8])
        print(f"  {head}" + (f" … 외 {len(unowned)-8}곳" if len(unowned) > 8 else ""))
        print("  세션은 여기를 건드리지 않습니다. 손대야 하는 작업은 제안에 그 사실을")
        print("  밝히게 되고, 다른 세션이 리뷰에서 판단합니다.")
        print("  자주 건드려야 한다면 .deputy/deputy.json 의 owns 에 직접 추가하세요.")

    if len([m for m in members if m.get("role") != COORDINATOR]) < 1:
        print("\n  [주의] 담당자가 없습니다.")
    if len(members) < 2:
        print("\n  [주의] 멤버가 1명이면 리뷰할 상대가 없어 토론과 합의가 일어나지 않습니다.")
        print("  제안은 45분 뒤 기권 처리되어 자동 진행됩니다. 이슈 기반 진행과")
        print("  파생 이슈 규칙은 그대로 동작하지만 교차 검증은 없습니다.")


def cmd_scan(cfg_unused, args):
    root = repo_root()
    cands = scan_repo(root)
    members, unowned = propose_members(cands, args.members, args.coordinator)
    print_scan(root, cands, members, unowned)
    print("\n이대로 설치하려면:")
    print(f"  deputy init" + (f" --members {args.members}" if args.members != 2 else ""))
    print("\n담당을 직접 정하려면:")
    parts = " \\\n              ".join(
        f'--member "{m["name"]}:{",".join(m["owns"])}:{m["brief"]}"' for m in members)
    print(f"  deputy init {parts}")


def cmd_init(cfg_unused, args):
    """
    저장소 하나를 무인 협업 가능한 상태로 만든다. 어느 프로젝트에서든 이 명령 하나면 된다.
      1) 멤버 설정 파일
      2) GitHub 라벨
      3) 스킬 (플러그인으로 설치했다면 --no-skills 로 건너뛴다)
      4) 프로젝트 설정 병합 (샌드박스 + push 차단)
      5) 개인 설정 병합 (리밋 자동 재개 + 세션 간 메시지 수신)
    기존 설정은 절대 덮어쓰지 않는다. 충돌하면 기존값을 두고 알려준다.
    """
    root = repo_root()
    print(f"=== deputy init :: {os.path.basename(root)} ===\n")

    if not gh(["repo", "view", "--json", "name"], check=False, parse=True):
        die("이 저장소에 GitHub 원격이 없습니다.\n"
            "  deputy 는 상태를 GitHub 이슈에 두므로 원격이 필요합니다.\n"
            "  gh repo create --source=. --private --push")

    # 1) 멤버 설정
    path = os.path.join(root, ".deputy", "deputy.json")
    if os.path.exists(path) and not args.force:
        print(f"  설정: {path} 이 이미 있습니다 (--force 로 덮어쓰기)")
        cfg = json.load(open(path))
    else:
        ms = []
        for spec in (args.member or []):
            parts = spec.split(":", 2)
            name = parts[0]
            owns = [x for x in (parts[1].split(",") if len(parts) > 1 and parts[1] else [])]
            # 담당 디렉터리를 비워두면 조율자로 본다
            ms.append({"name": name,
                       "role": BUILDER if owns else COORDINATOR,
                       "owns": owns,
                       "brief": parts[2] if len(parts) > 2 else ""})
        if not ms:
            # --member 를 안 줬으면 저장소 구조를 스캔해서 제안한다
            cands = scan_repo(root)
            if cands:
                ms, unowned = propose_members(cands, args.members, args.coordinator)
                print("  구조를 스캔해 멤버를 제안했습니다:")
                for m in ms:
                    tag = "[조율]" if m.get("role") == COORDINATOR else "[담당]"
                    print(f"    {tag} {m['name']:<12} {', '.join(m['owns']) or '(디렉터리 없음)'}")
                if unowned:
                    print(f"    (무주지 {len(unowned)}곳은 아무도 담당하지 않습니다)")
                print("  마음에 안 들면 .deputy/deputy.json 을 직접 고치거나")
                print("  deputy scan 으로 후보를 다시 보세요.")
            else:
                print("  [주의] 추적 중인 파일이 없어 구조를 감지하지 못했습니다.")
                ms = [{"name": "alpha", "owns": [], "brief": ""},
                      {"name": "beta", "owns": [], "brief": ""}]
        cfg = {"review_timeout_minutes": 45, "max_revisions": 2, "members": ms}
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            json.dump(cfg, f, indent=2, ensure_ascii=False)
        print(f"  설정: .deputy/deputy.json  멤버 {', '.join(members(cfg))}")

    # 2) 라벨
    made = 0
    for name, (color, desc) in LABELS.items():
        if gh(["label", "create", name, "--color", color,
               "--description", desc, "--force"], check=False) is not None:
            made += 1
    print(f"  라벨: {made}/{len(LABELS)} 생성")

    # 3) 스킬
    if args.skills:
        install_skills(os.path.join(root, ".claude", "skills"))
    else:
        print("  스킬: 건너뜀 (플러그인으로 설치됨)")

    # 4) 프로젝트 설정
    if args.settings:
        snip = os.path.join(PKG_DIR, "settings", "project-settings.json")
        if os.path.exists(snip):
            merge_settings(os.path.join(root, ".claude", "settings.json"),
                           json.load(open(snip)), "프로젝트 설정")
        else:
            print(f"  [건너뜀] 프로젝트 설정: {snip} 없음")

    # 5) 개인 설정
    if args.user_settings:
        snip = os.path.join(PKG_DIR, "settings", "user-settings.snippet.json")
        if os.path.exists(snip):
            merge_settings(os.path.join(HOME, ".claude", "settings.json"),
                           json.load(open(snip)), "개인 설정")
        else:
            print(f"  [건너뜀] 개인 설정: {snip} 없음")

    print("\n다음 두 가지를 하세요.\n")
    print("1) .deputy/deputy.json 에서 각 멤버의 owns 와 brief 를 채웁니다.")
    for m in cfg["members"]:
        gap = "owns 비어 있음" if not m.get("owns") else ", ".join(m["owns"])
        print(f"     {m['name']:<8} {gap}")
    print("   담당이 겹치면 두 세션이 같은 파일을 고쳐 충돌합니다. deputy doctor 가 잡아줍니다.\n")
    print("2) GitHub 에 작업 이슈를 만들어 둡니다. 세션은 여기서 다음 할 일을 고릅니다.")
    print("   제목 한 줄짜리도 괜찮습니다. 근거는 세션이 제안하며 채웁니다.\n")
    print("그다음:  deputy doctor   →   deputy-up.sh")


def parent_of(iss):
    """파생 이슈나 계획 자식이라면 부모(에픽) 번호를 돌려준다."""
    body = iss.get("body") or ""
    m = DERIVE_MARK.search(body) or PLANNED_MARK.search(body)
    return int(m.group("parent")) if m else None


def planned_meta(iss):
    """계획으로 만들어진 자식이면 담당자와 선행 이슈를 돌려준다."""
    m = PLANNED_MARK.search(iss.get("body") or "")
    if not m:
        return None
    after = [int(x) for x in (m.group("after") or "").split(",") if x.strip().isdigit()]
    return {"parent": int(m.group("parent")), "owner": m.group("owner"), "after": after}


def children_of(iss):
    """부모 본문의 체크리스트에서 파생 이슈 번호를 뽑는다."""
    return [int(m.group("num")) for m in TASKLINE.finditer(iss.get("body") or "")]


def open_children(iss):
    """아직 닫히지 않은 파생 이슈. 부모를 닫아도 되는지 판단하는 근거다."""
    out = []
    for n in children_of(iss):
        c = issue(n, cached=True, check=False)
        if c is None or c.get("state") == "OPEN":
            out.append(n)
    return out


def epic_state(full):
    """추적 중인 에픽을 '자식 다 끝난 것'과 '아직 남은 것'으로 가른다."""
    done, ongoing = [], []
    for num, d in full.items():
        if "deputy:epic" not in label_names(d):
            continue
        openk = open_children(d)
        (ongoing if openk else done).append((d, openk))
    done.sort(key=lambda t: t[0]["number"])
    ongoing.sort(key=lambda t: t[0]["number"])
    return done, ongoing


def cmd_derive(cfg, args):
    """
    작업 중 발견한 문제를 파생 이슈로 떼어낸다.
    합의 절차를 거치지 않는다. 파생 이슈는 '무엇을 할지에 대한 선택'이 아니라
    이미 합의된 부모의 완료 기준이 강제하는 사실이기 때문이다.
    대신 부모 본문에 체크리스트로 반드시 드러낸다.
    """
    me = whoami(cfg, args.as_)
    parent = issue(args.parent)

    if parent_of(parent) is not None:
        die(f"#{args.parent} 는 이미 파생 이슈입니다. 파생 이슈는 자식을 가질 수 없습니다.\n"
            f"  이 발견은 독립 이슈이거나 노트입니다.\n"
            f"  독립 이슈: gh issue create --title \"...\" --body \"#{args.parent} 작업 중 발견\"\n"
            f"  노트:      deputy note {args.parent} \"...\"")

    kids = children_of(parent)
    if len(kids) >= MAX_CHILDREN:
        die(f"#{args.parent} 의 파생 이슈가 이미 {len(kids)}개입니다 (상한 {MAX_CHILDREN}).\n"
            f"  파생이 더 필요하다는 건 부모의 범위 설정이 틀렸다는 신호입니다.\n"
            f"  더 만들지 말고 부모에 범위 문제를 남기고 넘어가세요:\n"
            f"    deputy note {args.parent} \"범위가 잘못 잡혔다. 이렇게 쪼개야 한다: ...\"")

    title = args.title or f"[#{args.parent} 파생] {args.why.strip().splitlines()[0][:70]}"
    body = (f"<!-- deputy v1 kind=derive by={me} parent={args.parent} -->\n"
            f"**Derived from #{args.parent}**\n\n"
            f"## 무엇을 발견했나\n{args.why}\n\n"
            f"## 왜 부모가 이것 없이는 끝날 수 없나\n{args.blocks}\n\n"
            f"## 완료 기준\n{args.done_when}\n\n"
            f"---\n"
            f"파생 이슈는 합의 절차를 거치지 않습니다. 범위 확장이라고 판단되면 "
            f"이 이슈에 코멘트로 이의를 제기하세요.")

    url = gh(["issue", "create", "--title", title, "--body", body,
              "--assignee", "@me"])
    child = None
    if url:
        m = re.search(r"/issues/(\d+)", url)
        child = int(m.group(1)) if m else None
    if not child:
        die("파생 이슈 생성에 실패했습니다. gh 출력을 확인하세요.")

    set_labels(child, add=["deputy:wip"], verify=False)

    # 부모 본문에 체크리스트를 덧붙인다. 직전에 다시 읽어 덮어쓸 위험을 줄인다.
    fresh = issue(args.parent, check=False) or parent
    pbody = fresh.get("body") or ""
    if "### 파생 이슈" not in pbody:
        pbody += "\n\n### 파생 이슈\n"
    pbody += f"- [ ] #{child} {title}\n"
    gh(["issue", "edit", str(args.parent), "--body", pbody], check=False)

    gh(["issue", "comment", str(args.parent), "--body",
        f"<!-- deputy v1 kind=note by={me} -->\n"
        f"### 🌱 파생 이슈 #{child} 생성\n\n{args.why}\n\n"
        f"이 이슈는 #{child} 가 닫히기 전에는 닫히지 않습니다."], check=False)

    print(f"파생 이슈 생성: #{child}  (부모 #{args.parent}, 파생 {len(kids)+1}/{MAX_CHILDREN})")
    print(f"  {url.strip()}")
    print("\n합의 절차 없이 바로 착수합니다. 끝나면:")
    print(f"  deputy done {child} --close --result \"...\"")
    print(f"부모 #{args.parent} 은 파생이 모두 닫힌 뒤에야 닫을 수 있습니다.")


# ---------------------------------------------------------------- 큰 이슈 분해

PLAN_TEMPLATE = """{
  "summary": "이 에픽을 왜 이렇게 쪼갰는지 한 문단. 순서의 근거를 포함할 것.",
  "children": [
    {
      "title": "오디오 캡처 모듈 뼈대와 인터페이스 확정",
      "owner": "audio",
      "why": "다른 모든 작업이 이 인터페이스에 의존한다. 먼저 고정해야 병렬 작업이 가능하다.",
      "done_when": "pytest -q tests/audio/test_capture.py 가 0으로 종료하고 녹음 픽스처 3건을 통과한다",
      "after": []
    },
    {
      "title": "STT 래퍼: WAV 입력을 텍스트로",
      "owner": "inference",
      "why": "캡처 인터페이스가 고정되면 독립적으로 개발 가능하다.",
      "done_when": "tests/fixtures/hello_ko.wav 입력 시 '안녕하세요' 를 포함한 텍스트가 나오고 pytest -q tests/stt 가 0으로 종료한다",
      "after": [1]
    }
  ]
}"""

DONE_WHEN_HINTS = ("pytest", "npm", "go test", "cargo", "make", "exit", "종료",
                   "통과", "`", "$", "0으로", "반환", "출력")


def validate_plan(cfg, plan, epic_num):
    """
    분해 품질을 여기서 강제한다. 이 검사가 이 기능의 값어치 전부다.
    나쁜 분해는 8시간을 통째로 태우는데, 그건 실행 중에는 아무도 못 알아챈다.
    """
    errs = []
    builders = [m["name"] for m in cfg["members"] if m.get("role") != COORDINATOR]

    if not isinstance(plan, dict):
        return ["최상위가 객체가 아닙니다."]
    if len((plan.get("summary") or "").strip()) < 30:
        errs.append("summary 가 너무 짧습니다. 왜 이렇게 쪼갰고 순서의 근거가 무엇인지 쓰세요.")

    children = plan.get("children")
    if not isinstance(children, list) or not children:
        return errs + ["children 이 비어 있습니다."]
    if len(children) > MAX_PLAN_CHILDREN:
        errs.append(f"자식이 {len(children)}개입니다 (상한 {MAX_PLAN_CHILDREN}). "
                    f"에픽 자체가 너무 큽니다. 에픽을 둘로 나누세요.")

    titles = set()
    for i, ch in enumerate(children, 1):
        tag = f"children[{i}]"
        if not isinstance(ch, dict):
            errs.append(f"{tag} 가 객체가 아닙니다."); continue

        title = (ch.get("title") or "").strip()
        if len(title) < 8:
            errs.append(f"{tag} title 이 너무 짧습니다.")
        elif title in titles:
            errs.append(f"{tag} title 이 중복됩니다: {title!r}")
        titles.add(title)

        owner = (ch.get("owner") or "").strip()
        if owner not in builders:
            errs.append(f"{tag} owner={owner!r} 는 담당자가 아닙니다. "
                        f"가능: {', '.join(builders)}. "
                        f"조율자는 구현하지 않으므로 담당이 될 수 없습니다.")

        if len((ch.get("why") or "").strip()) < 20:
            errs.append(f"{tag} why 가 너무 짧습니다. 왜 이 작업이 독립 단위인지 쓰세요.")

        dw = (ch.get("done_when") or "").strip()
        if len(dw) < 25:
            errs.append(f"{tag} done_when 이 너무 짧습니다.")
        elif not any(h in dw for h in DONE_WHEN_HINTS):
            errs.append(f"{tag} done_when 을 검증 가능하게 쓰세요. "
                        f"실행할 명령과 기대 결과가 들어가야 합니다.\n"
                        f"        지금: {dw[:80]}\n"
                        f"        예시: \"pytest -q tests/stt 가 0으로 종료한다\"")

        after = ch.get("after", [])
        if not isinstance(after, list) or any(not isinstance(x, int) for x in after):
            errs.append(f"{tag} after 는 정수 배열이어야 합니다 (children 의 1-based 순번).")
        else:
            for a in after:
                if not (1 <= a <= len(children)):
                    errs.append(f"{tag} after={a} 가 범위를 벗어났습니다.")
                elif a == i:
                    errs.append(f"{tag} 가 자기 자신을 선행으로 지정했습니다.")

    # 순환 의존 검사
    graph = {i: set(ch.get("after", []) or []) for i, ch in enumerate(children, 1)
             if isinstance(ch, dict)}
    seen, stack = set(), set()

    def cyc(n):
        if n in stack:
            return True
        if n in seen:
            return False
        seen.add(n); stack.add(n)
        for m in graph.get(n, ()):
            if isinstance(m, int) and cyc(m):
                return True
        stack.discard(n)
        return False

    if any(cyc(n) for n in list(graph)):
        errs.append("선행 관계에 순환이 있습니다. 그러면 아무것도 시작할 수 없습니다.")

    if graph and all(graph.get(i) for i in graph):
        errs.append("모든 자식에 선행 작업이 있습니다. 처음 시작할 수 있는 게 없습니다.")

    owners = {ch.get("owner") for ch in children if isinstance(ch, dict)}
    if len(owners) == 1 and len(builders) > 1:
        errs.append(f"모든 작업을 {owners.pop()!r} 혼자 맡습니다. 병렬로 돌릴 이유가 없어집니다. "
                    f"담당을 나눌 수 없다면 그건 하나의 작업이지 에픽이 아닙니다.")
    return errs


def cmd_plan(cfg, args):
    """
    큰 이슈(에픽)를 실행 가능한 작은 이슈로 쪼갠다.

    분해는 그 자체가 중요한 판단이므로 합의를 거친다. 파생 이슈와 다르다.
    파생은 이미 합의된 완료 기준이 강제하는 사실이지만, 분해는 여러 갈래 중
    하나를 고르는 선택이다. 잘못 고르면 8시간이 통째로 날아간다.
    """
    if args.template:
        print(PLAN_TEMPLATE)
        print("\n위 형식으로 파일을 만든 뒤:")
        print("  deputy plan <에픽번호> --file plan.json")
        print("\n지켜야 할 것:")
        print("  · owner 는 담당자 이름이어야 한다 (조율자는 불가)")
        print("  · done_when 은 실행할 명령과 기대 결과로 쓴다")
        print("  · after 는 선행 자식의 1-based 순번. 순환이 있으면 거부된다")
        print("  · 선행이 없는 자식이 최소 하나 있어야 한다")
        print(f"  · 자식은 최대 {MAX_PLAN_CHILDREN}개. 넘으면 에픽을 나눠야 한다")
        return

    cfg = cfg or load_config()
    me = whoami(cfg, args.as_)

    if args.number is None:
        die("에픽 이슈 번호가 필요합니다.  deputy plan <번호> --file plan.json")

    epic = issue(args.number)

    # --apply: 합의된 계획을 실제 이슈로 만든다
    if args.apply:
        cs = deputy_comments(epic)
        plans = [c for c in cs if c["kind"] == "plan"]
        if not plans:
            die(f"#{args.number} 에 계획이 없습니다. 먼저 deputy plan {args.number} --file ... 을 하세요.")
        v = consensus(cfg, epic)
        if v["decision"] not in ("CLAIM", "ESCALATE") and not args.force:
            die(f"계획이 아직 합의되지 않았습니다. 판정: {v['decision']}\n  {v['reason']}")

        m = PLAN_JSON.search(plans[-1]["body"])
        if not m:
            die("계획 코멘트에서 deputy-plan 블록을 찾지 못했습니다.")
        plan = json.loads(m.group("body"))
        errs = validate_plan(cfg, plan, args.number)
        if errs:
            die("계획이 유효하지 않습니다:\n  " + "\n  ".join(errs))

        created = []
        for i, ch in enumerate(plan["children"], 1):
            after_nums = [created[a - 1] for a in ch.get("after", []) if a <= len(created)]
            body = (f"<!-- deputy v1 kind=planned by={me} parent={args.number} "
                    f"owner={ch['owner']}"
                    + (f" after={','.join(str(x) for x in after_nums)}" if after_nums else "")
                    + " -->\n"
                    f"**에픽 #{args.number} 의 계획된 작업**\n\n"
                    f"## 왜 이 작업인가\n{ch['why']}\n\n"
                    f"## 완료 기준\n{ch['done_when']}\n\n"
                    + (f"## 선행 작업\n" + "\n".join(f"- #{x}" for x in after_nums) + "\n\n"
                       if after_nums else "")
                    + f"---\n담당: `{ch['owner']}`  ·  이 이슈는 승인된 계획에서 나왔으므로 "
                      f"다시 제안·합의할 필요가 없습니다. 바로 착수하세요.")
            url = gh(["issue", "create", "--title", ch["title"], "--body", body])
            num = int(re.search(r"/issues/(\d+)", url or "").group(1)) if url and re.search(r"/issues/(\d+)", url) else None
            if not num:
                die(f"자식 이슈 생성 실패: {ch['title']}")
            set_labels(num, add=["deputy:agreed"], verify=False)
            created.append(num)
            print(f"  #{num}  {ch['title']}   ← {ch['owner']}")

        fresh = issue(args.number, check=False) or epic
        pbody = fresh.get("body") or ""
        if "### 계획된 작업" not in pbody:
            pbody += "\n\n### 계획된 작업\n"
        for num, ch in zip(created, plan["children"]):
            pbody += f"- [ ] #{num} {ch['title']}\n"
        gh(["issue", "edit", str(args.number), "--body", pbody], check=False)
        set_labels(args.number, add=["deputy:epic"],
                   remove=["deputy:next", "deputy:agreed", "deputy:revise"], verify=False)
        gh(["issue", "comment", str(args.number), "--body",
            f"<!-- deputy v1 kind=note by={me} -->\n"
            f"### 🧩 계획 적용: 자식 이슈 {len(created)}건 생성\n\n"
            + "\n".join(f"- #{n}" for n in created)
            + f"\n\n이 에픽은 위 이슈가 모두 닫히기 전에는 닫히지 않습니다."], check=False)

        print(f"\n에픽 #{args.number} 에 자식 {len(created)}건을 연결했습니다.")
        print("각 자식은 승인된 계획에서 나왔으므로 재합의 없이 바로 착수 가능합니다.")
        print("다음: deputy next")
        return

    # 계획 제출
    if not args.file:
        die("계획 파일이 필요합니다.  deputy plan <번호> --file plan.json\n"
            "  형식을 보려면: deputy plan --template")
    try:
        plan = json.load(open(os.path.expanduser(args.file)))
    except Exception as e:
        die(f"{args.file} 을 읽을 수 없습니다: {e}")

    errs = validate_plan(cfg, plan, args.number)
    if errs:
        print("계획이 품질 기준을 통과하지 못했습니다:\n", file=sys.stderr)
        for e in errs:
            print(f"  · {e}", file=sys.stderr)
        print("\n고친 뒤 다시 제출하세요. 이 검사를 건너뛸 수 없습니다.", file=sys.stderr)
        print("나쁜 분해는 실행 중에는 아무도 못 알아채고 8시간을 통째로 태웁니다.", file=sys.stderr)
        sys.exit(2)

    cs = deputy_comments(epic)
    prev = [c for c in cs if c["kind"] == "plan"]
    rev = (prev[-1]["rev"] + 1) if prev else 1

    lines = []
    for i, ch in enumerate(plan["children"], 1):
        dep = f"  (선행: {', '.join('#'+str(a) for a in ch.get('after', []))})" if ch.get("after") else ""
        lines.append(f"{i}. **{ch['title']}** — `{ch['owner']}`{dep}\n"
                     f"   - 왜: {ch['why']}\n"
                     f"   - 완료: {ch['done_when']}")

    body = (f"<!-- deputy v1 kind=plan by={me} rev={rev} -->\n"
            f"## 🧩 `{me}` 의 분해안" + (f" (수정본 rev{rev})" if rev > 1 else "") + "\n\n"
            f"{plan['summary']}\n\n"
            f"### 자식 작업 {len(plan['children'])}건\n\n" + "\n\n".join(lines) + "\n\n"
            f"<details><summary>적용용 원본</summary>\n\n"
            f"```deputy-plan\n{json.dumps(plan, ensure_ascii=False, indent=2)}\n```\n\n</details>\n\n"
            f"---\n분해는 이 실행의 방향을 결정합니다. 형식적으로 동의하지 말고 확인하세요:\n"
            f"· 담당이 실제로 갈리는가, 아니면 같은 파일을 여럿이 건드리게 되는가\n"
            f"· 순서가 맞는가. 인터페이스를 고정하는 작업이 먼저인가\n"
            f"· 각 완료 기준이 사람 없이 검증 가능한가\n"
            f"· 빠진 것이 있는가\n\n"
            f"`deputy review {args.number} --verdict AGREE|OBJECT|AMEND --reason \"...\"`")
    gh(["issue", "comment", str(args.number), "--body", body])
    set_labels(args.number, add=["deputy:next"], remove=["deputy:revise"], verify=False)

    others = [m for m in members(cfg) if m != me]
    print(f"분해안 제출: #{args.number} rev{rev}  자식 {len(plan['children'])}건")
    print(f"  검증 통과. 리뷰 대상: {', '.join(others) or '(단독)'}")
    print(f"  {epic['url']}")
    print(f"\n합의되면:  deputy plan {args.number} --apply")
    print("기다리는 동안 멈추지 마세요. deputy next 로 다음 할 일을 확인하세요.")


def cmd_propose(cfg, args):
    me = whoami(cfg, args.as_)
    iss = issue(args.number)
    if iss["state"] != "OPEN":
        die(f"#{args.number} 는 닫힌 이슈입니다.")

    cs = deputy_comments(iss)
    prev = [c for c in cs if c["kind"] == "propose"]
    # 다른 멤버가 이미 제안한 이슈에는 제안하지 않는다. 최초 제안이 동시에 들어오는
    # 경우도 막아야 한다. 그러지 않으면 나중 것만 살아남고 앞선 제안은 조용히 버려진다.
    other = [c for c in prev if c["by"] != me]
    if other:
        die(f"#{args.number} 는 이미 {other[-1]['by']} 가 제안했습니다 "
            f"(rev{other[-1]['rev']}, {stamp(other[-1]['at'])}).\n"
            f"  제안 대신 리뷰하세요: deputy review {args.number} --verdict AGREE|OBJECT|AMEND --reason \"...\"")
    rev = (prev[-1]["rev"] + 1) if prev else 1

    body = (
        f"<!-- deputy v1 kind=propose by={me} rev={rev} -->\n"
        f"## 🔷 `{me}` 가 다음 작업으로 제안합니다"
        + (f" (수정본 rev{rev})" if rev > 1 else "") + "\n\n"
        f"**왜 지금 이것인가**\n{args.why}\n\n"
        + (f"**검토한 대안**\n{args.alternatives}\n\n" if args.alternatives else "")
        + (f"**영향 범위**\n`{args.files}`\n\n" if args.files else "")
        + (f"**예상 규모** {args.estimate}\n\n" if args.estimate else "")
        + f"**완료 기준**\n{args.done_when}\n\n"
        f"---\n"
        f"다른 세션은 `deputy review {args.number} --verdict AGREE|OBJECT|AMEND --reason \"...\"` 로 검토해 주세요. "
        f"{cfg['review_timeout_minutes']}분 내 리뷰가 없으면 기권 처리되어 자동 진행됩니다."
    )
    gh(["issue", "comment", str(args.number), "--body", body])
    set_labels(args.number, add=["deputy:next"], remove=["deputy:revise"])

    others = [m for m in members(cfg) if m != me]
    print(f"제안 등록: #{args.number} rev{rev}  {iss['title']}")
    print(f"  리뷰 대상: {', '.join(others) or '(단독)'}")
    print(f"  {iss['url']}")
    if others:
        print(f"\n지금 할 일: 다른 세션에 알리세요 →  \"@{others[0]} 이슈 #{args.number} 리뷰 부탁해\"")
    print("기다리는 동안 멈추지 마세요. `deputy next` 가 할 일을 알려줍니다.")


def cmd_review(cfg, args):
    me = whoami(cfg, args.as_)
    if args.verdict not in VERDICTS:
        die(f"verdict 는 {', '.join(VERDICTS)} 중 하나입니다.")
    if len(args.reason.strip()) < 15:
        die("reason 을 구체적으로 쓰세요. 근거 없는 동의는 합의가 아니라 요식입니다.\n"
            "무엇을 확인했고, 무엇이 우려되고, 대안은 무엇인지 적으세요.")

    iss = issue(args.number)
    cs = deputy_comments(iss)
    props = [c for c in cs if c["kind"] == "propose"]
    if not props:
        die(f"#{args.number} 에는 제안이 없습니다. 먼저 deputy propose 가 필요합니다.")
    p = props[-1]
    if p["by"] == me:
        die("자기 제안은 리뷰할 수 없습니다.")

    icon = {"AGREE": "✅", "OBJECT": "⛔", "AMEND": "✏️"}[args.verdict]
    body = (f"<!-- deputy v1 kind=review by={me} rev={p['rev']} verdict={args.verdict} -->\n"
            f"### {icon} `{me}` 의 검토: **{args.verdict}**\n\n{args.reason}\n")
    gh(["issue", "comment", str(args.number), "--body", body])

    iss = issue(args.number)                       # 방금 쓴 코멘트를 포함해 다시 판정
    v = consensus(cfg, iss)
    sync_label(cfg, args.number, v["decision"])

    print(f"리뷰 기록: #{args.number} ← {args.verdict}")
    print(f"\n판정: {v['decision']}\n  {v['reason']}")
    if v["decision"] != "WAIT":
        print(f"\n제안자에게 알리세요: \"@{p['by']} #{args.number} 리뷰했어. 판정 {v['decision']}\"")


def cmd_consensus(cfg, args):
    iss = issue(args.number)
    v = consensus(cfg, iss)
    sync_label(cfg, args.number, v["decision"])
    print(f"{v['decision']}\n{v['reason']}")
    if args.verbose:
        print("\n" + json.dumps(v["detail"], indent=2, ensure_ascii=False))
    sys.exit(0 if v["decision"] in ("CLAIM", "ESCALATE") else 3)


def cmd_claim(cfg, args):
    """
    모든 세션이 같은 GitHub 계정으로 움직이므로 assignee 는 잠금이 되지 못한다
    (두 세션이 같은 @me 를 붙여도 둘 다 성공한다). 그래서 착수 코멘트를 먼저 남기고,
    다시 읽어서 '가장 먼저 남긴 착수 코멘트'가 내 것인지 확인한다.
    내 것이 아니면 물러난다. 원자적이지는 않지만, 진 쪽이 스스로 알아차린다.
    """
    me = whoami(cfg, args.as_)
    if role_of(cfg, me) == COORDINATOR and not args.force:
        die("조율자는 작업에 착수하지 않습니다. 담당 디렉터리가 없어 고칠 자리가 없습니다.\n"
            "  코드 변경이 필요하면 담당 세션에 메시지로 요청하세요.\n"
            "  조율자가 할 일은 deputy next 가 알려줍니다.")
    iss = issue(args.number)
    v = consensus(cfg, iss)
    if v["decision"] not in ("CLAIM", "ESCALATE") and not args.force:
        die(f"아직 착수할 수 없습니다. 판정: {v['decision']}\n  {v['reason']}")

    prior = [c for c in deputy_comments(iss) if c["kind"] == "claim"]
    if prior and prior[0]["by"] != me and not args.force:
        die(f"#{args.number} 는 {prior[0]['by']} 가 {stamp(prior[0]['at'])} 에 착수했습니다.\n"
            f"  deputy next 로 다른 할 일을 받으세요.")

    gh(["issue", "comment", str(args.number), "--body",
        f"<!-- deputy v1 kind=claim by={me} -->\n"
        f"### 🛠 `{me}` 착수\n합의 판정: **{v['decision']}** — {v['reason']}"])

    # 경합 확인. 내가 쓰기 직전에 다른 세션이 먼저 썼을 수 있다.
    after = issue(args.number, check=False)
    if after:
        claims = [c for c in deputy_comments(after) if c["kind"] == "claim"]
        if claims and claims[0]["by"] != me:
            winner = claims[0]["by"]
            gh(["issue", "comment", str(args.number), "--body",
                f"<!-- deputy v1 kind=note by={me} -->\n"
                f"### ↩️ `{me}` 착수 철회\n`{winner}` 가 먼저 착수했습니다. 물러납니다."],
               check=False)
            print(f"경합에서 밀렸습니다. #{args.number} 는 {winner} 가 진행합니다.")
            print("deputy next 로 다음 할 일을 받으세요.")
            sys.exit(3)

    gh(["issue", "edit", str(args.number), "--add-assignee", "@me"], check=False)
    set_labels(args.number, add=["deputy:wip"],
               remove=["deputy:next", "deputy:agreed", "deputy:revise"])

    print(f"착수: #{args.number} — {iss['title']}")
    if v["decision"] == "ESCALATE":
        print("주의: 이견이 남은 채 진행합니다. 범위를 좁히고 근거를 이슈에 남기세요.")
    mc = member_cfg(cfg, me)
    if mc.get("owns"):
        print(f"담당 밖의 파일은 건드리지 마세요. 내 담당: {', '.join(mc['owns'])}")


def cmd_done(cfg, args):
    """
    완료 처리. 두 가지를 반드시 지킨다.
      1) assignee 를 항상 지운다. 닫지 않은 채 배정만 남으면 그 이슈는 deputy next 의
         후보 필터에서도, 추적 목록에서도 빠져 영영 보이지 않게 된다.
      2) 열린 파생 이슈가 있으면 부모를 닫지 않는다. 다만 여기서 대기하지 않는다.
    """
    me = whoami(cfg, args.as_)
    iss = issue(args.number)

    gh(["issue", "comment", str(args.number), "--body",
        f"<!-- deputy v1 kind=done by={me} -->\n### ✅ `{me}` 완료\n\n{args.result}\n"])

    kids = open_children(iss)
    closed = False
    if args.close:
        if kids:
            print(f"완료 기록: #{args.number} — 그러나 이슈를 닫지 않았습니다.")
            print(f"\n열린 파생 이슈가 {len(kids)}건 있습니다: "
                  + ", ".join(f"#{k}" for k in kids))
            print("부모는 파생이 모두 닫힌 뒤에 닫힙니다.")
            print("\n여기서 기다리지 마세요. 지금 바로 `deputy next` 를 실행하면")
            print("다음에 처리할 파생 이슈를 알려줍니다.")
            set_labels(args.number, remove=["deputy:wip"], verify=False)
            gh(["issue", "edit", str(args.number), "--remove-assignee", "@me"], check=False)
            sys.exit(3)
        gh(["issue", "close", str(args.number)], check=False)
        closed = True

    set_labels(args.number, remove=["deputy:wip", "deputy:next", "deputy:agreed"], verify=False)
    gh(["issue", "edit", str(args.number), "--remove-assignee", "@me"], check=False)

    print(f"완료 기록: #{args.number}" + (" (이슈 닫음)" if closed else " (열린 채로 둠)"))

    parent = parent_of(iss)
    if parent and closed:
        print(f"\n부모 이슈 #{parent} 의 파생 하나가 닫혔습니다.")
        rem = open_children(issue(parent, check=False) or {})
        if rem:
            print(f"  아직 열린 파생: {', '.join(f'#{k}' for k in rem)}")
        else:
            print(f"  파생이 모두 닫혔습니다. 이제 #{parent} 을 닫을 수 있습니다:")
            print(f"    deputy done {parent} --close --result \"...\"")

    if args.no_next:
        print("\n멈추지 마세요. `deputy next` 로 다음 할 일을 확인하세요.")
        return

    # 여기서 끊기면 세션이 한 턴을 그냥 흘려보낸다. 바로 다음 할 일까지 이어준다.
    print("\n" + "─" * 70)
    ISSUE_CACHE.clear()
    nxt = argparse.Namespace(as_=args.as_, cmd="next")
    cmd_next(cfg, nxt)


def next_for_coordinator(cfg, me, full, active, out):
    """
    조율자는 구현하지 않는다. 담당 디렉터리가 없으므로 코드를 고칠 자리도 없다.
    대신 아무도 보지 않는 것을 본다 - 제안들 사이의 충돌, 정체된 작업, 무주지, 빈 백로그.
    """
    # 1순위: 내 리뷰. 조율자의 본업이다.
    owed = []
    for num, d in full.items():
        if "deputy:next" not in label_names(d):
            continue
        cs = deputy_comments(d)
        props = [c for c in cs if c["kind"] == "propose"]
        if not props or props[-1]["by"] == me:
            continue
        pr = props[-1]
        if not any(c["kind"] == "review" and c["by"] == me and c["rev"] == pr["rev"] for c in cs):
            owed.append((d, pr))
    if owed:
        out.append("[1순위] 검토할 제안이 있습니다. 조율자의 본업입니다.")
        for d, pr in owed:
            out.append(f"  · #{d['number']} (rev{pr['rev']}, 제안자 {pr['by']}) {d['title']}")
            out.append(f"    {d['url']}")
        out.append("    담당자는 자기 영역만 봅니다. 당신은 전체를 봅니다. 이걸 확인하세요:")
        out.append("      · 지금 진행 중인 다른 작업과 충돌하는가")
        out.append("      · 순서가 맞는가. 먼저 해야 할 게 있지 않은가")
        out.append("      · 담당 밖(무주지) 파일을 건드리려 하는가")
        out.append("      · 완료 기준이 정말 검증 가능한가")
        out.append('    → deputy review <번호> --verdict AGREE|OBJECT|AMEND --reason "..."')
        out.append("")

    # 2순위: 중재. 합의가 깨진 것들.
    blocked = [d for n, d in full.items() if "deputy:blocked" in label_names(d)]
    if blocked:
        out.append("[2순위] 합의가 깨진 이슈가 있습니다. 중재가 필요합니다.")
        for d in blocked:
            out.append(f"  · #{d['number']} {d['title']}")
            for c in deputy_comments(d):
                if c["kind"] == "review" and c["verdict"] != "AGREE":
                    txt = MARK.sub("", c["body"]).strip().replace("\n", " ")
                    out.append(f"    ← {c['by']} ({c['verdict']}): {txt[:200]}")
        out.append("    → 양쪽 근거를 읽고 이슈에 판단을 남기세요. 범위를 어떻게 좁힐지,")
        out.append("      아니면 둘로 쪼갤지 정하고 그 이유를 씁니다.")
        out.append('      deputy note <번호> "조율 판단: ..."')
        out.append("")

    # 2순위: 자식이 모두 끝난 에픽을 닫는다.
    # 이걸 아무도 안 하면 에픽이 열린 채 라벨에 갇혀 어느 목록에도 안 나온다.
    epics_done, epics_open = epic_state(full)
    if epics_done:
        out.append("[2순위] 자식이 모두 닫힌 에픽이 있습니다. 마감하세요.")
        for d, _ in epics_done:
            kids = children_of(d)
            out.append(f"  · #{d['number']} {d['title']}  (자식 {len(kids)}건 완료)")
        out.append("    → 자식들의 결과를 종합해 무엇을 이뤘는지 정리한 뒤:")
        out.append('      deputy done <번호> --close --result "에픽 완료: ..."')
        out.append("    에픽을 닫아야 다음 에픽으로 넘어갑니다.")
        out.append("")

    # 2.5순위: 내가 올린 분해안의 판정
    for num, d in full.items():
        cs = deputy_comments(d)
        plans = [c for c in cs if c["kind"] == "plan"]
        if not plans or plans[-1]["by"] != me or children_of(d):
            continue
        v = consensus(cfg, d)
        if v["decision"] in ("CLAIM", "ESCALATE"):
            out.append(f"[2순위] 내 분해안 #{num} 이 합의됐습니다 ({v['decision']}).")
            out.append(f"    → deputy plan {num} --apply   (자식 이슈를 생성한다)")
            out.append("")
        elif v["decision"] == "REVISE":
            out.append(f"[2순위] 내 분해안 #{num} 에 이견이 있습니다.")
            for c in cs:
                if c["kind"] == "review" and c["rev"] == plans[-1]["rev"] and c["verdict"] != "AGREE":
                    txt = MARK.sub("", c["body"]).strip().replace("\n", " ")
                    out.append(f"    ← {c['by']} ({c['verdict']}): {txt[:220]}")
            out.append(f"    → 고쳐서 다시: deputy plan {num} --file plan.json")
            out.append("")

    # 3순위: 전체 그림. 조율자만 볼 수 있는 것.
    wip = [d for n, d in full.items() if "deputy:wip" in label_names(d)]
    open_props = [d for n, d in full.items() if "deputy:next" in label_names(d)]
    if wip or open_props or epics_open:
        out.append("[3순위] 전체 현황을 점검하세요. 이걸 보는 건 당신뿐입니다.")
        if epics_open:
            out.append("  진행 중 에픽:")
            for d, openk in epics_open:
                kids = children_of(d)
                out.append(f"    · #{d['number']} {d['title'][:40]}  "
                           f"({len(kids)-len(openk)}/{len(kids)} 완료, "
                           f"남은 자식 {', '.join('#'+str(k) for k in openk[:4])})")
        if wip:
            out.append("  진행 중:")
            for d in wip:
                cs = deputy_comments(d)
                who = next((c["by"] for c in reversed(cs) if c["kind"] == "claim"), "?")
                last = max((c["at"] for c in cs), default=0)
                idle = (time.time() - last) / 3600 if last else 0
                flag = f"  [{idle:.1f}시간째 무소식]" if idle > 2 else ""
                out.append(f"    · #{d['number']} {d['title'][:44]} ← {who}{flag}")
        if open_props:
            out.append("  검토 대기:")
            for d in open_props:
                out.append(f"    · #{d['number']} {d['title'][:44]}")
        out.append("    확인할 것:")
        out.append("      · 두 작업이 같은 파일을 건드리려 하는가 → 해당 세션에 알린다")
        out.append("      · 오래 멈춰 있는 작업이 있는가 → 담당 세션에 상황을 묻는다")
        out.append("      · 순서가 뒤집힌 게 있는가 → 이슈에 지적한다")
        out.append("")

    # 4순위: 백로그 관리. 구현 대신 이걸 한다.
    cand = sorted([i for i in active
                   if not (label_names(i) & set(LABELS)) and not i["assignees"]],
                  key=lambda x: x["number"])
    if not out:
        out.append("[4순위] 급한 게 없습니다. 백로그를 손보세요.")
        out.append("")
        if len(cand) < 3:
            out.append(f"  후보 이슈가 {len(cand)}건뿐입니다. 세션들이 곧 할 일을 잃습니다.")
            out.append("  코드를 읽고 다음 작업을 발굴해 이슈로 등록하세요:")
            out.append('    gh issue create --title "..." --body "왜 필요한지와 완료 기준"')
        else:
            out.append(f"  후보 이슈 {len(cand)}건:")
            for i in cand[:10]:
                out.append(f"    · #{i['number']} {i['title']}")
            out.append("  확인할 것:")
            out.append("    · 너무 커서 한 번에 못 끝낼 이슈가 있는가 → 쪼갠다")
            out.append("    · 근거나 완료 기준이 없는 이슈가 있는가 → 코멘트로 채운다")
            out.append("    · 지금 우선순위가 틀린 게 있는가 → 이슈에 의견을 남긴다")
        out.append("")
        out.append("  구현하지 마세요. 담당 디렉터리가 없습니다.")
        out.append("  코드를 고쳐야 한다면 담당 세션에 메시지로 요청하세요.")


def cmd_next(cfg, args):
    """
    이 도구의 심장. 세션은 매 턴 이걸 실행하고 나온 지시를 그대로 따른다.
    우선순위: 사람의 개입 > 남을 막지 않기 > 내 일 끝내기 > 새 일 벌이기.

    같은 이슈를 여러 번 받아오지 않도록 한 번만 조회해 캐시한다.
    조회가 실패한 이슈는 건너뛰고 나머지를 계속 처리한다. gh 호출 하나가 실패했다고
    그 턴의 지시 전체를 날리면, 아무도 없는 8시간 동안 세션이 그냥 멈춘다.
    """
    me = whoami(cfg, args.as_)
    mc = member_cfg(cfg, me)
    role = "조율자" if role_of(cfg, me) == COORDINATOR else "담당자"
    print(f"=== deputy next :: {me} ({role}) ===")
    if mc.get("brief"):
        print(f"역할: {mc['brief']}")
    if mc.get("owns"):
        print(f"담당: {', '.join(mc['owns'])}  (이 밖의 파일은 수정 금지)")
    print()

    active = active_issues()
    tracked = [i for i in active if label_names(i) & set(LABELS)]

    full, skipped = {}, []
    for i in tracked:
        d = issue(i["number"], cached=True, check=False)
        if d is None:
            skipped.append(i["number"])
        else:
            full[i["number"]] = d

    out = []
    if role_of(cfg, me) == COORDINATOR:
        if skipped:
            out.append(f"[안내] 조회 실패로 건너뛴 이슈: " + ", ".join(f"#{n}" for n in skipped))
            out.append("")
        # 0순위(사람 코멘트)는 역할과 무관하게 먼저 본다
        human = []
        for num, d in full.items():
            cs = deputy_comments(d)
            last_bot = cs[-1]["at"] if cs else 0
            for c in human_comments_since(d, last_bot):
                human.append((d, c))
        if human:
            out.append("[0순위] 사람이 코멘트를 남겼습니다. 다른 무엇보다 먼저 반영하세요.")
            for d, c in human:
                out.append(f"  · #{d['number']} {d['title']}")
                out.append(f"    \"{c['body'].strip()[:260]}\"")
            out.append("    → 지시대로 조율하고, 이슈에 어떻게 반영했는지 코멘트로 답하세요.")
            out.append("")
        next_for_coordinator(cfg, me, full, active, out)
        print("\n".join(out))
        return

    if skipped:
        out.append(f"[안내] 조회 실패로 이번 턴에 건너뛴 이슈: "
                   + ", ".join(f"#{n}" for n in skipped))
        out.append("")

    # 0순위: 사람의 코멘트. 무인 운영 중 유일한 외부 신호다.
    human = []
    for num, d in full.items():
        cs = deputy_comments(d)
        last_bot = cs[-1]["at"] if cs else 0
        for c in human_comments_since(d, last_bot):
            human.append((d, c))
    if human:
        out.append("[0순위] 사람이 코멘트를 남겼습니다. 다른 무엇보다 먼저 반영하세요.")
        for d, c in human:
            out.append(f"  · #{d['number']} {d['title']}")
            out.append(f"    \"{c['body'].strip()[:260]}\"")
        out.append("    → 지시대로 계획을 고치고, 어떻게 반영했는지 이슈에 코멘트로 답하세요.")
        out.append("")

    # 1순위: 내 리뷰를 기다리며 남이 막혀 있는 것
    owed = []
    for num, d in full.items():
        if "deputy:next" not in label_names(d):
            continue
        cs = deputy_comments(d)
        props = [c for c in cs if c["kind"] == "propose"]
        if not props or props[-1]["by"] == me:
            continue
        pr = props[-1]
        if not any(c["kind"] == "review" and c["by"] == me and c["rev"] == pr["rev"] for c in cs):
            owed.append((d, pr))
    owed.sort(key=lambda t: t[0]["number"])
    if owed:
        out.append("[1순위] 다른 세션이 당신의 리뷰를 기다립니다. 이게 최우선입니다.")
        for d, pr in owed:
            out.append(f"  · #{d['number']} (rev{pr['rev']}, 제안자 {pr['by']}) {d['title']}")
            out.append(f"    {d['url']}")
        out.append("    → 제안 근거를 읽고 관련 코드를 실제로 확인한 뒤 판단하세요:")
        out.append('      deputy review <번호> --verdict AGREE|OBJECT|AMEND --reason "확인한 것과 우려"')
        out.append("    형식적으로 AGREE 만 찍으면 합의가 무의미해집니다. 실제로 코드를 보세요.")
        out.append("")

    # 2순위: 내가 착수한 작업. 파생 이슈를 부모보다 먼저 끝낸다.
    mine_wip = []
    for num, d in full.items():
        if "deputy:wip" not in label_names(d):
            continue
        claims = [c for c in deputy_comments(d) if c["kind"] == "claim"]
        derived = parent_of(d) is not None
        # 파생 이슈는 착수 코멘트 없이 바로 생성되므로 kind=derive 마커로도 소유를 판단한다
        dm = DERIVE_MARK.search(d.get("body") or "")
        mine = (claims and claims[-1]["by"] == me) or (derived and dm and f"by={me} " in dm.group(0))
        if mine:
            mine_wip.append((d, derived))
    if mine_wip:
        mine_wip.sort(key=lambda x: (not x[1], x[0]["number"]))  # 파생 먼저, 그다음 번호순   # 파생 먼저, 그다음 번호순
        out.append("[2순위] 진행 중인 작업이 있습니다. 새 일을 벌이기 전에 끝내세요.")
        for d, derived in mine_wip:
            tag = f"  (부모 #{parent_of(d)} 의 파생 — 이걸 닫아야 부모가 닫힙니다)" if derived else ""
            out.append(f"  · #{d['number']} {d['title']}{tag}")
            kids = open_children(d)
            if kids:
                out.append(f"    열린 파생: {', '.join(f'#{k}' for k in kids)} "
                           f"— 이것들을 먼저 끝내야 합니다")
        out.append('    → 끝나면: deputy done <번호> --close --result "무엇을 했고 어떻게 검증했는지"')
        out.append("    → 작업 중 부모의 완료 기준을 위협하는 문제를 발견하면:")
        out.append('      deputy derive <부모번호> --why "..." --blocks "..." --done-when "..."')
        out.append("")

    # 2.5순위: 계획으로 배정된 작업. 이미 합의된 것이라 바로 착수한다.
    planned_mine, blocked_mine = [], []
    for num, d in full.items():
        meta = planned_meta(d)
        if not meta or meta["owner"] != me:
            continue
        if "deputy:wip" in label_names(d) or d.get("assignees"):
            continue
        unmet = []
        for a in meta["after"]:
            dep = issue(a, cached=True, check=False)
            if dep is None or dep.get("state") == "OPEN":
                unmet.append(a)
        (blocked_mine if unmet else planned_mine).append((d, meta, unmet))
    planned_mine.sort(key=lambda t: t[0]["number"])
    blocked_mine.sort(key=lambda t: t[0]["number"])
    if planned_mine:
        out.append("[2순위] 계획으로 배정된 작업이 있습니다. 이미 합의된 것이라 바로 착수합니다.")
        for d, meta, _ in planned_mine:
            out.append(f"  · #{d['number']} {d['title']}  (에픽 #{meta['parent']})")
        out.append(f"    → deputy claim <번호>   (재합의 불필요)")
        out.append("")
    if blocked_mine and not planned_mine:
        out.append("[대기] 내게 배정됐지만 선행 작업이 안 끝났습니다.")
        for d, meta, unmet in blocked_mine:
            out.append(f"  · #{d['number']} {d['title']}")
            out.append(f"    선행: {', '.join('#'+str(x) for x in unmet)} 이 아직 열려 있습니다")
        out.append("    멈추지 말고 선행 작업의 인터페이스를 미리 읽어두거나,")
        out.append("    테스트를 먼저 써두세요. 선행이 닫히는 즉시 구현에 들어갈 수 있습니다.")
        out.append("")

    # 조율자가 없는 구성에서는 담당자가 에픽 마감을 맡는다.
    # 그러지 않으면 에픽이 열린 채 어느 목록에도 나오지 않는다.
    if not coordinators(cfg):
        epics_done, _ = epic_state(full)
        if epics_done:
            out.append("[2순위] 자식이 모두 닫힌 에픽이 있습니다. 마감하세요.")
            for d, _ in epics_done:
                out.append(f"  · #{d['number']} {d['title']}")
            out.append('    → deputy done <번호> --close --result "에픽 완료: ..."')
            out.append("    에픽을 닫아야 다음 에픽으로 넘어갑니다.")
            out.append("")

    # 3순위: 내 제안의 판정
    waiting = []
    for num, d in full.items():
        if not (label_names(d) & {"deputy:next", "deputy:agreed", "deputy:revise", "deputy:blocked"}):
            continue
        cs = deputy_comments(d)
        props = [c for c in cs if c["kind"] == "propose"]
        if not props or props[-1]["by"] != me:
            continue
        v = consensus(cfg, d)
        sync_label(cfg, num, v["decision"])
        if v["decision"] == "WAIT":
            waiting.append((d, v))
            continue
        out.append(f"[3순위] 내 제안 #{num} 판정: {v['decision']}")
        out.append(f"  {d['title']}")
        out.append(f"  {v['reason']}")
        if v["decision"] == "REVISE":
            for c in cs:
                if c["kind"] == "review" and c["rev"] == props[-1]["rev"] and c["verdict"] != "AGREE":
                    txt = MARK.sub("", c["body"]).strip().replace("\n", " ")
                    out.append(f"    ← {c['by']} ({c['verdict']}): {txt[:240]}")
            out.append(f'    → deputy propose {num} --why "이견을 이렇게 반영했다" --done-when "..."')
        else:
            out.append(f"    → deputy claim {num}")
        out.append("")

    # 4순위: 새 작업
    if not out or all(l.startswith("[안내]") or not l for l in out):
        if waiting:
            out.append("[대기] 내 제안이 리뷰를 기다립니다. 그래도 멈추지 마세요.")
            for d, v in waiting:
                out.append(f"  · #{d['number']} {d['title']}")
                out.append(f"    {v['reason']}")
            out.append("")
            out.append("지금 할 것 — 합의 직후 바로 구현에 들어갈 수 있게 준비하세요:")
            out.append("  · 관련 코드를 읽고 현재 동작을 파악한다")
            out.append("  · 재현 케이스나 실패하는 테스트를 먼저 써둔다")
            out.append("  · 알아낸 것을 deputy note 로 이슈에 남긴다 (사람이 폰으로 읽습니다)")
        else:
            cand = sorted([i for i in active
                           if not (label_names(i) & set(LABELS)) and not i["assignees"]],
                          key=lambda x: x["number"])
            out.append("[새 작업] 막고 있는 것도 진행 중인 것도 없습니다. 다음 작업을 제안하세요.")
            out.append("")
            if cand:
                out.append("열려 있는 후보 이슈:")
                for i in cand[:12]:
                    out.append(f"  · #{i['number']} {i['title']}")
                out.append("")
                out.append("내 담당 영역에 해당하는 것을 하나 고르고, 먼저 크기를 판단하세요.")
                out.append("")
                out.append("  한 번에 끝낼 수 있다 → 제안:")
                out.append('  deputy propose <번호> --why "왜 지금 이것인지" \\')
                out.append('    --alternatives "다른 후보를 왜 뒤로 미뤘는지" \\')
                out.append('    --done-when "무엇이 참이면 끝인지 (명령과 기대 출력으로)"')
                out.append("")
                out.append("")
                out.append("  한 번에 못 끝낼 만큼 크다 → 분해:")
                out.append("  deputy plan --template   후   deputy plan <번호> --file plan.json")
                out.append("  큰 이슈를 그대로 붙잡으면 컨텍스트가 넘쳐 세션이 멈춥니다.")
                out.append("")
                out.append("근거 없는 제안은 리뷰에서 막힙니다. 대안을 최소 하나 비교하세요.")
            else:
                out.append("후보 이슈가 없습니다. 할 일이 정말 없다면:")
                out.append("  · 작업 중 발견한 문제를 gh issue create 로 등록하고")
                out.append("  · 사람이 아침에 읽을 수 있게 근거를 적어두세요")
                out.append("  · 그다음 deputy note 로 상황을 남기고 이번 턴을 마칩니다")

    print("\n".join(out))


# ---------------------------------------------------------------- 통합 진입점

def decide_action(cfg, me, iss):
    """
    이 이슈에 대해 지금 내가 할 일을 판단한다. 순수 함수라 네트워크를 타지 않는다.

    반환: (종류, 설명줄들, 자동실행할 인자들 또는 None)
      자동 실행은 '인자 없이 결정되는 행동'만 한다. 판단이 필요한 것(제안·리뷰·완료)은
      바로 붙여넣을 수 있는 명령을 대신 출력한다.
    """
    num = iss["number"]
    labels = label_names(iss)
    cs = deputy_comments(iss)
    props = [c for c in cs if c["kind"] == "propose"]
    plans = [c for c in cs if c["kind"] == "plan"]
    claims = [c for c in cs if c["kind"] == "claim"]
    meta = planned_meta(iss)
    role = role_of(cfg, me)
    L = []

    if iss.get("state") != "OPEN":
        return "closed", ["이미 닫힌 이슈입니다."], None

    # 에픽 — 자식 진행 상황을 본다
    if "deputy:epic" in labels:
        kids = children_of(iss)
        openk = open_children(iss)
        L.append(f"에픽입니다. 자식 {len(kids)}건 중 {len(kids)-len(openk)}건 완료.")
        if openk:
            L.append(f"  열린 자식: {', '.join('#'+str(k) for k in openk)}")
            L.append("  에픽은 자식이 모두 닫혀야 닫힙니다. deputy next 로 다음 자식을 받으세요.")
            return "epic-open", L, None
        L.append("  자식이 모두 닫혔습니다. 에픽을 닫을 수 있습니다:")
        L.append(f'    deputy done {num} --close --result "에픽 완료: 무엇을 이뤘는지"')
        return "epic-done", L, None

    # 분해안이 올라와 있는 경우
    if plans and not children_of(iss):
        v = consensus(cfg, iss)
        if v["decision"] in ("CLAIM", "ESCALATE"):
            L.append(f"분해안이 합의됐습니다 ({v['decision']}). 자식 이슈를 생성합니다.")
            return "plan-apply", L, ["plan", str(num), "--apply"]
        if v["decision"] == "REVISE":
            L.append(f"분해안에 이견이 있습니다. {v['reason']}")
            for c in cs:
                if c["kind"] == "review" and c["rev"] == plans[-1]["rev"] and c["verdict"] != "AGREE":
                    txt = MARK.sub("", c["body"]).strip().replace("\n", " ")
                    L.append(f"  ← {c['by']} ({c['verdict']}): {txt[:220]}")
            L.append(f"  고쳐서 다시 제출하세요:  deputy plan {num} --file plan.json")
            return "plan-revise", L, None
        if plans[-1]["by"] != me and not any(
                c["kind"] == "review" and c["by"] == me and c["rev"] == plans[-1]["rev"] for c in cs):
            L.append("분해안을 검토해야 합니다. 이 판단이 실행 전체의 방향을 정합니다.")
            L.append("  담당이 실제로 갈리는가 / 순서가 맞는가 / 완료 기준이 검증 가능한가")
            L.append(f'  deputy review {num} --verdict AGREE|OBJECT|AMEND --reason "..."')
            return "plan-review", L, None
        L.append(f"분해안 검토 대기 중입니다. {v['reason']}")
        return "plan-wait", L, None

    # 계획으로 배정된 자식
    if meta:
        if meta["owner"] != me:
            L.append(f"이 작업은 {meta['owner']} 에게 배정됐습니다 (에픽 #{meta['parent']}).")
            return "not-mine", L, None
        if claims:
            L.append(f"이미 착수했습니다. 끝나면:")
            L.append(f'  deputy done {num} --close --result "무엇을 했고 어떻게 검증했는지"')
            L.append(f'  작업 중 부모의 완료 기준을 위협하는 문제를 발견하면:')
            L.append(f'  deputy derive {num} --why "..." --blocks "..." --done-when "..."')
            return "mine-wip", L, None
        L.append(f"계획으로 내게 배정된 작업입니다 (에픽 #{meta['parent']}). 재합의 불필요.")
        return "planned-claim", L, ["claim", str(num)]

    # 일반 제안 흐름
    if not props:
        if role == COORDINATOR:
            L.append("아직 제안되지 않았습니다. 조율자는 제안 대신 분해를 검토합니다.")
            L.append("  이 이슈가 한 번에 끝낼 수 없을 만큼 크면 분해하세요:")
            L.append(f"    deputy plan --template   후  deputy plan {num} --file plan.json")
            return "coord-idle", L, None
        L.append("아직 제안되지 않았습니다. 크기를 먼저 판단하세요.")
        L.append("  한 번에 끝낼 수 있다 → 제안:")
        L.append(f'    deputy propose {num} --why "왜 지금 이것인지" \\')
        L.append(f'      --alternatives "다른 후보를 왜 미뤘는지" \\')
        L.append(f'      --done-when "무엇이 참이면 끝인지 (명령과 기대 출력으로)"')
        L.append("  너무 크다 → 분해:")
        L.append(f"    deputy plan --template   후  deputy plan {num} --file plan.json")
        return "propose", L, None

    p = props[-1]
    v = consensus(cfg, iss)

    if claims:
        owner = claims[0]["by"]
        if owner != me:
            L.append(f"{owner} 가 {stamp(claims[0]['at'])} 에 착수해 진행 중입니다.")
            L.append("  건드리지 마세요. deputy next 로 내 할 일을 받으세요.")
            return "other-wip", L, None
        L.append("내가 착수한 작업입니다.")
        L.append(f'  끝나면: deputy done {num} --close --result "무엇을 했고 어떻게 검증했는지"')
        L.append(f'  문제 발견: deputy derive {num} --why "..." --blocks "..." --done-when "..."')
        return "mine-wip", L, None

    if p["by"] != me:
        done = any(c["kind"] == "review" and c["by"] == me and c["rev"] == p["rev"] for c in cs)
        if not done:
            L.append(f"{p['by']} 의 제안(rev{p['rev']})을 검토해야 합니다.")
            L.append("  제안이 건드린다는 파일을 실제로 읽고 판단하세요.")
            if role == COORDINATOR:
                L.append("  조율자는 전체 관점을 봅니다: 다른 작업과 충돌하는가, 순서가 맞는가.")
            L.append(f'  deputy review {num} --verdict AGREE|OBJECT|AMEND --reason "확인한 것과 우려"')
            return "review", L, None
        L.append(f"이미 검토했습니다. 현재 판정: {v['decision']} — {v['reason']}")
        return "reviewed", L, None

    # 내 제안
    if v["decision"] in ("CLAIM", "ESCALATE"):
        L.append(f"내 제안이 합의됐습니다 ({v['decision']}). {v['reason']}")
        if role == COORDINATOR:
            L.append("  다만 조율자는 착수하지 않습니다. 담당 세션에 요청하세요.")
            return "coord-cant-claim", L, None
        return "claim", L, ["claim", str(num)]
    if v["decision"] == "REVISE":
        L.append(f"내 제안에 이견이 있습니다. {v['reason']}")
        for c in cs:
            if c["kind"] == "review" and c["rev"] == p["rev"] and c["verdict"] != "AGREE":
                txt = MARK.sub("", c["body"]).strip().replace("\n", " ")
                L.append(f"  ← {c['by']} ({c['verdict']}): {txt[:220]}")
        L.append(f'  고쳐서 다시: deputy propose {num} --why "이견을 이렇게 반영했다" --done-when "..."')
        return "revise", L, None
    L.append(f"리뷰 대기 중입니다. {v['reason']}")
    L.append("  멈추지 마세요. 관련 코드를 읽고 실패하는 테스트를 먼저 써두면")
    L.append("  합의 직후 바로 구현에 들어갈 수 있습니다.")
    return "wait", L, None


def cmd_at(cfg, args):
    """deputy <이슈번호> — 이 이슈에 대해 지금 할 일을 판단하고, 자명한 것은 바로 실행한다."""
    me = whoami(cfg, args.as_)
    iss = issue(args.number)

    labels = ", ".join(sorted(label_names(iss))) or "라벨 없음"
    assignee = iss["assignees"][0]["login"] if iss.get("assignees") else "없음"
    print(f"#{iss['number']}  {iss['title']}")
    print(f"  상태 {iss['state']}  ·  {labels}  ·  배정 {assignee}")
    print(f"  {iss['url']}")
    print(f"  나: {me} ({'조율자' if role_of(cfg, me) == COORDINATOR else '담당자'})")
    print()

    kind, lines, auto = decide_action(cfg, me, iss)
    for l in lines:
        print(l)

    if not auto:
        return
    if args.dry:
        print(f"\n[--dry] 자동 실행할 명령: deputy {' '.join(auto)}")
        return

    print(f"\n→ 자동 실행: deputy {' '.join(auto)}\n")
    sub_args = main_parser().parse_args(auto)
    sub_args.as_ = args.as_
    sub_args.fn(cfg, sub_args)


def cmd_status(cfg, args):
    print(f"=== deputy status ===  멤버: {', '.join(members(cfg))}\n")
    tracked = [i for i in list_issues(limit=60) if label_names(i) & set(LABELS)]
    if not tracked:
        print("추적 중인 이슈가 없습니다. `deputy next` 로 시작하세요.")
        return
    order = ["deputy:epic", "deputy:wip", "deputy:next", "deputy:agreed",
             "deputy:revise", "deputy:blocked"]
    titles = {"deputy:epic": "에픽", "deputy:wip": "진행 중", "deputy:next": "리뷰 대기",
              "deputy:agreed": "합의 완료", "deputy:revise": "수정 필요",
              "deputy:blocked": "막힘 - 사람 필요"}
    for lb in order:
        group = [i for i in tracked if lb in label_names(i)]
        if not group:
            continue
        print(f"[{titles[lb]}] {len(group)}건")
        for i in group:
            full = issue(i["number"])
            v = consensus(cfg, full)
            d = v["detail"]
            who = ""
            cs = deputy_comments(full)
            actor = [c for c in cs if c["kind"] in ("claim", "propose")]
            if actor:
                who = f"  ← {actor[-1]['by']}"
            tail = ""
            if d:
                tail = (f"  동의{len(d.get('agree',[]))} 반대{len(d.get('object',[]))} "
                        f"대기{len(d.get('pending',[]))}")
            print(f"  #{i['number']:<5} {i['title'][:46]:<48}{who}{tail}")
        print()
    if args.web:
        gh(["issue", "list", "--web"], check=False)


def cmd_note(cfg, args):
    me = whoami(cfg, args.as_)
    gh(["issue", "comment", str(args.number), "--body",
        f"<!-- deputy v1 kind=note by={me} -->\n### 📝 `{me}` 메모\n\n{args.text}"])
    print(f"메모 기록: #{args.number}")


def cmd_doctor(cfg, args):
    ok, warn, bad = [], [], []

    a = gh(["auth", "status"], check=False)
    (ok if a is not None else bad).append(
        "gh 인증됨" if a is not None else "gh 인증 실패 → `gh auth login`")

    if gh(["repo", "view", "--json", "name"], check=False, parse=True):
        ok.append("GitHub 저장소 연결됨")
    else:
        bad.append("이 디렉터리에 GitHub 원격이 없습니다 → `gh repo create` 또는 원격 추가")

    have = {l["name"] for l in (gh(["label", "list", "--json", "name"],
                                  check=False, parse=True) or [])}
    miss = set(LABELS) - have
    (ok if not miss else bad).append(
        "deputy 라벨 준비됨" if not miss else f"라벨 누락: {', '.join(sorted(miss))} → `deputy init --force`")

    open_issues = list_issues()
    free = [i for i in open_issues
            if not (label_names(i) & set(LABELS)) and not i["assignees"]]

    orphans = [i for i in open_issues
               if not (label_names(i) & set(LABELS)) and i["assignees"]]
    if orphans:
        bad.append("배정만 남고 라벨이 없는 이슈가 있습니다 → 어떤 경로에서도 보이지 않습니다: "
                   + ", ".join(f"#{i['number']}" for i in orphans)
                   + "  (gh issue edit <번호> --remove-assignee @me 로 풀어주세요)")
    (ok if free else bad).append(
        f"작업 후보 이슈 {len(free)}건" if free
        else "열린 이슈가 없습니다 → 세션이 할 일을 못 찾습니다. 이슈를 먼저 만드세요")

    seen = {}
    if not coordinators(cfg):
        warn.append("조율자가 없습니다 → 제안 사이의 충돌과 우선순위를 볼 사람이 없습니다 "
                    "(deputy init 이 기본으로 넣어줍니다)")
    for m in cfg["members"]:
        if m.get("role") == COORDINATOR:
            if m.get("owns"):
                bad.append(f"조율자 '{m['name']}' 에게 owns 가 있습니다 → 조율자는 구현하지 "
                           f"않습니다. owns 를 비우세요")
            continue
        if not m.get("owns"):
            warn.append(f"'{m['name']}' 의 owns 가 비어 있습니다 → 파일 충돌 위험")
        if not m.get("brief"):
            warn.append(f"'{m['name']}' 의 brief 가 비어 있습니다 → 제안 품질이 떨어집니다")
        for d in (m.get("owns", []) if m.get("role") != COORDINATOR else []):
            if d in seen:
                bad.append(f"담당 겹침: '{d}' 를 {seen[d]} 와 {m['name']} 가 함께 소유")
            seen[d] = m["name"]

    if subprocess.run(["pgrep", "-x", "caffeinate"], capture_output=True).returncode == 0:
        ok.append("F-01 caffeinate 실행 중")
    else:
        bad.append("F-01 caffeinate 가 없습니다 → `caffeinate -dimsu &`")

    if sys.platform == "darwin":
        pm = subprocess.run(["pmset", "-g", "ps"], capture_output=True, text=True).stdout
        (ok if "AC Power" in pm else bad).append(
            "F-01 전원 연결됨" if "AC Power" in pm else "F-01 배터리 동작 중 → 전원을 연결하세요")

    us = {}
    try:
        us = json.load(open(os.path.expanduser("~/.claude/settings.json")))
    except Exception:
        warn.append("~/.claude/settings.json 을 읽지 못했습니다")
    for key, want, code in (("autoContinueAtUsageLimit", True, "F-05"),
                            ("crossSessionInbound", "accept", "F-04")):
        got = us.get(key)
        (ok if got == want else bad).append(
            f"{code} {key}={got}" if got == want
            else f"{code} {key} 가 {got!r} 입니다 → {want!r} 로 바꾸세요")

    print("=== deputy doctor ===\n")
    for label, items, mark in (("정상", ok, "  ok  "), ("주의", warn, " warn "), ("차단", bad, " STOP ")):
        if items:
            print(f"[{label}]")
            for i in items:
                print(f"{mark}{i}")
            print()
    print("차단 항목이 남아 있으면 무인 운영을 시작하지 마세요." if bad else "무인 운영 준비 완료.")
    sys.exit(1 if bad else 0)


# ---------------------------------------------------------------- 진입점

def main_parser():
    ap = argparse.ArgumentParser(
        prog="deputy", description=__doc__, epilog=WORKFLOW,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--as", dest="as_", help="내 멤버 이름 (기본: 환경변수 DEPUTY_MEMBER)")
    sub = ap.add_subparsers(dest="cmd")

    def add(name, help_, example=None):
        return sub.add_parser(
            name, help=help_,
            description=help_,
            epilog=("예시\n" + example) if example else None,
            formatter_class=argparse.RawDescriptionHelpFormatter)

    s = add("init", "현재 저장소를 무인 협업 가능한 상태로 만든다", """
  deputy init --member "api:src/api,tests/api:백엔드 API 와 그 테스트" \\
              --member "web:src/web:프론트엔드 UI"

  담당 디렉터리(owns)가 겹치면 두 세션이 같은 파일을 고쳐 충돌한다.
  겹침은 deputy doctor 가 잡아준다.
""")
    s.add_argument("--member", action="append", help="이름:담당디렉터리,쉼표:역할설명")
    s.add_argument("--force", action="store_true", help="기존 멤버 설정을 덮어쓴다")
    s.add_argument("--members", type=int, default=2, metavar="N",
                   help="자동 감지 시 만들 담당자 수 (기본 2). 조율자는 별도로 추가된다")
    s.add_argument("--no-coordinator", dest="coordinator", action="store_false",
                   help="전체를 조율하는 멤버를 만들지 않는다")
    s.add_argument("--no-skills", dest="skills", action="store_false",
                   help="스킬 복사를 건너뛴다 (플러그인으로 설치한 경우)")
    s.add_argument("--no-settings", dest="settings", action="store_false",
                   help="프로젝트 설정 병합을 건너뛴다")
    s.add_argument("--no-user-settings", dest="user_settings", action="store_false",
                   help="개인 설정 병합을 건너뛴다")
    s.set_defaults(fn=cmd_init, needs_cfg=False, skills=True, settings=True,
                   user_settings=True, coordinator=True)

    s = add("self-install", "deputy 를 PATH 에 심볼릭 링크로 올린다", """
  deputy self-install --prefix ~/.local/bin
""")
    s.add_argument("--prefix", default="~/.local/bin", help="링크를 놓을 디렉터리")
    s.add_argument("--force", action="store_true", help="기존 링크를 덮어쓴다")
    s.set_defaults(fn=cmd_self_install, needs_cfg=False)

    s = add("scan", "저장소 구조를 훑어 멤버 구성을 제안한다 (아무것도 바꾸지 않음)", """
  deputy scan
  deputy scan --members 3

  git 이 추적하는 파일만 본다. .gitignore 가 이미 걸러준 것을 다시 거르지 않는다.
  src/ packages/ 같은 껍데기 디렉터리는 한 단계 더 들어가고,
  tests/api 는 src/api 에 자동으로 붙는다.
""")
    s.add_argument("--members", type=int, default=2, metavar="N",
                   help="제안할 담당자 수 (기본 2). 조율자는 별도로 추가된다")
    s.add_argument("--no-coordinator", dest="coordinator", action="store_false",
                   help="전체를 조율하는 멤버를 만들지 않는다")
    s.set_defaults(fn=cmd_scan, needs_cfg=False, coordinator=True)

    s = add("next", "지금 무엇을 해야 하는지 (매 턴 실행)", """
  deputy next

  매 턴 가장 먼저 실행한다. 무엇을 할지는 이 출력이 정한다.
  DEPUTY_MEMBER 환경변수로 자기가 누구인지 알려야 한다:
    DEPUTY_MEMBER=api deputy next
""")
    s.set_defaults(fn=cmd_next)

    s = add("plan", "큰 이슈를 실행 가능한 작은 이슈들로 쪼갠다", """
  deputy plan --template            형식과 규칙을 본다
  deputy plan 7 --file plan.json    분해안을 제출한다 (검증 후 합의 대기)
  deputy plan 7 --apply             합의된 분해안을 실제 이슈로 만든다

  분해는 합의를 거친다. 파생 이슈와 다르다.
  파생은 이미 합의된 완료 기준이 강제하는 사실이지만,
  분해는 여러 갈래 중 하나를 고르는 선택이다. 잘못 고르면 8시간이 날아간다.
""")
    s.add_argument("number", type=int, nargs="?", help="에픽 이슈 번호")
    s.add_argument("--file", help="분해안 JSON 파일")
    s.add_argument("--template", action="store_true", help="형식과 규칙을 출력한다")
    s.add_argument("--apply", action="store_true", help="합의된 분해안을 이슈로 만든다")
    s.add_argument("--force", action="store_true", help="합의 전에 적용한다")
    s.set_defaults(fn=cmd_plan, needs_cfg=False)

    s = add("propose", "이슈를 다음 작업으로 제안한다", """
  deputy propose 12 \\
    --why "인증이 막혀 다른 작업 3건이 대기 중이다. 이걸 먼저 풀어야 한다" \\
    --alternatives "#14 UI 개선도 후보였으나 의존하는 작업이 없어 뒤로 미뤘다" \\
    --done-when "pytest -q tests/auth 가 0으로 종료하고 로그인 e2e 가 통과한다" \\
    --files "src/auth,tests/auth" --estimate "2h"

  --why 와 --done-when 은 필수다. 근거 없는 제안과 검증 불가능한 완료 기준은
  리뷰에서 막힌다. --done-when 은 명령과 기대 출력으로 쓴다.
""")
    s.add_argument("number", type=int, help="제안할 GitHub 이슈 번호")
    s.add_argument("--why", required=True, help="왜 지금 이것인가")
    s.add_argument("--done-when", dest="done_when", required=True,
                   help="무엇이 참이면 끝인가. 명령과 기대 출력으로 쓸 것")
    s.add_argument("--alternatives", help="다른 후보를 왜 뒤로 미뤘는가")
    s.add_argument("--files", help="영향 범위. 쉼표로 구분")
    s.add_argument("--estimate", help="예상 규모. 예: 2h")
    s.set_defaults(fn=cmd_propose)

    s = add("derive", "작업 중 발견한 문제를 파생 이슈로 떼어낸다", """
  deputy derive 12 \\
    --why "설정 로더가 잘못된 YAML 을 조용히 삼킨다" \\
    --blocks "설정이 깨진 채로 통과하면 '임계값대로 제한된다'를 검증할 수 없다" \\
    --done-when "잘못된 YAML 로 기동 시 명확한 에러와 함께 종료한다"

  파생 이슈 판단 기준 — 세 질문을 순서대로:
    1. 안 고쳐도 부모의 완료 기준이 통과하나? → 예면 독립 이슈
    2. 안 고친 채 부모를 닫아도 안전한가?     → 예면 독립 이슈
    3. 둘 다 아니오                            → 파생 이슈
  깊이는 1단계까지, 부모당 3개까지. 합의 절차를 거치지 않는다.
""")
    s.add_argument("parent", type=int, help="문제를 발견한 부모 이슈 번호")
    s.add_argument("--why", required=True, help="무엇을 발견했는가")
    s.add_argument("--blocks", required=True,
                   help="왜 부모가 이것 없이는 완료 기준을 만족시킬 수 없는가")
    s.add_argument("--done-when", dest="done_when", required=True,
                   help="이 파생 작업의 완료 기준")
    s.add_argument("--title", help="파생 이슈 제목 (기본: --why 첫 줄로 자동 생성)")
    s.set_defaults(fn=cmd_derive)

    s = add("review", "남의 제안을 검토한다", """
  deputy review 12 --verdict AMEND \\
    --reason "방향은 맞지만 src/db/session.py 도 같이 바뀌어야 한다.
              지금 범위로는 마이그레이션 후 세션이 깨진다."

  AGREE 를 찍기 전에 반드시 제안이 건드린다는 파일을 실제로 읽는다.
  형식적 동의는 합의 절차 전체를 무의미하게 만든다.
""")
    s.add_argument("number", type=int, help="검토할 이슈 번호")
    s.add_argument("--verdict", required=True, help="AGREE | OBJECT | AMEND")
    s.add_argument("--reason", required=True)
    s.set_defaults(fn=cmd_review)

    s = add("consensus", "합의 상태를 판정한다", """
  deputy consensus 12 -v
""")
    s.add_argument("number", type=int, help="판정할 이슈 번호")
    s.add_argument("-v", "--verbose", action="store_true", help="집계 내역까지 출력")
    s.set_defaults(fn=cmd_consensus)

    s = add("claim", "합의된 작업에 착수한다", """
  deputy claim 12

  합의(CLAIM/ESCALATE)가 난 뒤에만 착수할 수 있다.
""")
    s.add_argument("number", type=int, help="착수할 이슈 번호")
    s.add_argument("--force", action="store_true", help="합의 판정과 경합 확인을 무시한다")
    s.set_defaults(fn=cmd_claim)

    s = add("done", "작업을 완료 처리한다", """
  deputy done 12 --close \\
    --result "토큰 만료 처리를 추가하고 tests/auth 12건이 통과함을 확인했다"

  열린 파생 이슈가 있으면 부모는 닫히지 않는다.
  그때는 기다리지 말고 deputy next 로 다음 파생 이슈를 받는다.
""")
    s.add_argument("number", type=int, help="완료 처리할 이슈 번호")
    s.add_argument("--result", required=True, help="무엇을 했고 어떻게 검증했는지")
    s.add_argument("--close", action="store_true", help="이슈를 닫는다")
    s.add_argument("--no-next", action="store_true",
                   help="완료 후 다음 할 일을 이어서 보여주지 않는다")
    s.set_defaults(fn=cmd_done)

    s = add("note", "이슈에 메모를 남긴다", """
  deputy note 12 "리팩터링 중 발견: 이 경로는 캐시를 두 번 탄다. 별도 이슈 필요."
""")
    s.add_argument("number", type=int, help="메모를 남길 이슈 번호")
    s.add_argument("text", help="메모 내용")
    s.set_defaults(fn=cmd_note)

    s = add("status", "전체 현황", """
  deputy status
  deputy status --web    # 브라우저로도 연다
""")
    s.add_argument("--web", action="store_true", help="브라우저로도 연다")
    s.set_defaults(fn=cmd_status)

    s = add("doctor", "무인 운영 전 점검", """
  deputy doctor

  무인 운영을 시작하기 전에 반드시 통과시킨다.
  차단 항목이 있으면 종료코드 1 을 반환하고 deputy-up.sh 가 기동을 멈춘다.
""")
    s.set_defaults(fn=cmd_doctor)

    s = add("at", "이슈 번호 하나로 지금 할 일을 판단한다 (deputy <번호> 와 같다)", """
  deputy 7            #7 에 대해 지금 할 일을 판단하고 자명한 것은 바로 실행
  deputy 7 --dry      실행하지 않고 무엇을 할지만 본다

  인자가 필요 없는 행동(착수, 분해안 적용)은 자동으로 실행한다.
  판단이 필요한 행동(제안, 리뷰, 완료)은 붙여넣을 명령을 출력한다.
""")
    s.add_argument("number", type=int, help="이슈 번호")
    s.add_argument("--dry", action="store_true", help="실행하지 않고 보여만 준다")
    s.set_defaults(fn=cmd_at)

    return ap


def main():
    # `deputy 7` 을 `deputy at 7` 로 바꿔준다
    # 전역 플래그를 건너뛴 뒤 첫 토큰이 숫자면 at 명령으로 본다
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        tok = argv[i]
        if tok == "--as":
            i += 2
            continue
        if tok.startswith("--as="):
            i += 1
            continue
        if tok.isdigit():
            argv = argv[:i] + ["at"] + argv[i:]
        break

    ap = main_parser()
    args = ap.parse_args(argv)

    if not args.cmd:
        # 인자 없이 부르면 지금 상태에 맞는 다음 한 걸음을 알려준다
        print(__doc__.strip())
        print(WORKFLOW)
        try:
            root = repo_root()
            ready = os.path.isfile(os.path.join(root, ".deputy", "deputy.json"))
        except SystemExit:
            root, ready = None, False
        print("현재 상태")
        print("─" * 73)
        if root is None:
            print("  git 저장소 밖입니다. 적용할 프로젝트로 이동하세요.")
        elif not ready:
            print(f"  {os.path.basename(root)} 에 아직 설치되지 않았습니다.")
            print("  다음 명령으로 시작하세요:")
            print('    deputy init --member "이름:담당디렉터리:역할설명"')
        else:
            cfg = load_config()
            print(f"  {os.path.basename(root)} · 멤버 {', '.join(members(cfg))}")
            print("  deputy doctor   무인 운영 전 점검")
            print("  deputy next     지금 할 일 확인")
            print("  deputy status   전체 현황")
        print()
        print("자세한 도움말:  deputy <명령> --help")
        sys.exit(0)

    cfg = None if getattr(args, "needs_cfg", True) is False else load_config()
    args.fn(cfg, args)


if __name__ == "__main__":
    main()
